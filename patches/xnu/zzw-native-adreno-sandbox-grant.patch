 /* Routine io_service_open_ndr */
+/*
+ * The native GPU driver names, by the property NativeSandboxGrantProcess on its accelerator service, the processes (a comma-separated list of
+ * process names, the render server and the other processes that run its Metal plugin) to which it grants its own user client in place of the
+ * sandbox's verdict: the original profiles name no class of that driver. Nothing else is affected.
+ */
+extern "C" void proc_selfname(char * buf, int size);
+static bool
+native_sandbox_grant(IOService * service)
+{
+	OSString * list = OSDynamicCast(OSString, service->getProperty("NativeSandboxGrantProcess"));
+	char name[17] = {};
+	if (!list) {
+		return false;
+	}
+	proc_selfname(name, sizeof(name));
+	for (const char * at = list->getCStringNoCopy(); *at;) {
+		size_t length = 0;
+		while (at[length] && at[length] != ',') {
+			++length;
+		}
+		/* A process name holds 16 characters, so a longer entry is compared by its first 16. */
+		if (length && 0 == strncmp(name, at, length < sizeof(name) - 1 ? length : sizeof(name) - 1)
+		    && (length >= sizeof(name) - 1 || name[length] == 0)) {
+			return true;
+		}
+		at += length + (at[length] == ',' ? 1 : 0);
+	}
+	return false;
+}
+
+/*
+ * The native Metal accelerator accepts the signed Metal entitlement for its
+ * plugin connection and progress markers. Existing process grants retain
+ * their service-specific policy for system components.
+ */
+static bool
+native_sandbox_grant_open(IOService * service, task_t owning_task, uint32_t connect_type)
+{
+	if (native_sandbox_grant(service)) {
+		return true;
+	}
+
+	const OSMetaClass * meta = service->getMetaClass();
+	OSString * plugin = OSDynamicCast(OSString, service->getProperty("MetalPluginName"));
+	OSString * plugin_class = OSDynamicCast(OSString, service->getProperty("MetalPluginClassName"));
+	OSString * entitlement = OSDynamicCast(OSString, service->getProperty("NativeSandboxGrantEntitlement"));
+	OSNumber * native_type = OSDynamicCast(OSNumber, service->getProperty("NativeSandboxGrantConnectType"));
+	if (!meta || 0 != strcmp(meta->getClassName(), "AGXAccelerator")
+	    || !plugin || !plugin->isEqualTo("NativeAdrenoMetal")
+	    || !plugin_class || !plugin_class->isEqualTo("NativeAdrenoMetalDevice")
+	    || !entitlement || !entitlement->isEqualTo("com.apple.security.ts.opengl-or-metal")
+	    || !native_type || native_type->unsigned32BitValue() != 0x4147) {
+		return false;
+	}
+
+	const uint32_t connection_type = native_type->unsigned32BitValue();
+	const bool plugin_connection = connect_type == connection_type;
+	const bool progress_marker = (connect_type >> 16) == connection_type && (connect_type & 0xffff) != 0;
+	if (!plugin_connection && !progress_marker) {
+		return false;
+	}
+
+	return IOTaskHasEntitlement(owning_task, entitlement->getCStringNoCopy());
+}
