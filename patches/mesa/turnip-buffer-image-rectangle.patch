+static nir_shader *
+build_buffer_copy_fs_shader(void)
+{
+   nir_builder builder =
+      nir_builder_init_simple_shader(MESA_SHADER_FRAGMENT, NULL, "buffer copy fs");
+   nir_builder *b = &builder;
+
+   nir_variable *out_color =
+      nir_create_variable_with_location(b->shader, nir_var_shader_out,
+                                        FRAG_RESULT_DATA0, glsl_vec4_type());
+   nir_variable *in_coords =
+      nir_create_variable_with_location(b->shader, nir_var_shader_in,
+                                        VARYING_SLOT_VAR0, glsl_vec2_type());
+
+   b->shader->info.num_textures = 1;
+   BITSET_SET(b->shader->info.textures_used, 0);
+   BITSET_SET(b->shader->info.textures_used_by_txf, 0);
+
+   /* The full destination rectangle addresses source rows by their actual
+    * stride, as Mesa's vk_meta buffer-to-image fragment copy does. Turnip's
+    * formatted buffer descriptor supplies the UNORM conversion and swizzle.
+    */
+   nir_def *coords = nir_f2u32(b, nir_load_var(b, in_coords));
+   nir_def *row = nir_imul(b, nir_channel(b, coords, 1), load_const(b, 0, 1));
+   nir_def *index = nir_iadd(b, row, nir_channel(b, coords, 0));
+   nir_def *texel = nir_txf(b, index,
+                           .texture_index = 0,
+                           .dim = GLSL_SAMPLER_DIM_BUF,
+                           .dest_type = nir_type_float32);
+   nir_store_var(b, out_color, texel, 0xf);
    return b->shader;
 }
 
