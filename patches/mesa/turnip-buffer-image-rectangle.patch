+                             source_stride, 1);
+   r3d_coords(cmd, cs, {offset.x, offset.y}, {0, 0}, {extent.width, extent.height});
+
+   for (uint32_t layer = 0; layer < layers; layer++) {
+      uint32_t descriptor[FDL6_TEX_CONST_DWORDS];
+      /* The buffer descriptor retains the source's texel offset within its
+       * aligned address. Its range includes row gaps through the last texel;
+       * the shader fetches only coordinates inside the destination rectangle.
