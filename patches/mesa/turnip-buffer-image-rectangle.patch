+   case PIPE_FORMAT_R8_UNORM:
+   case PIPE_FORMAT_R8G8_UNORM:
+   case PIPE_FORMAT_R8G8B8A8_UNORM:
+   case PIPE_FORMAT_B8G8R8A8_UNORM:
+      break;
+   default:
+      return false;
+   }
+
+   const uint32_t block_size = util_format_get_blocksize(format);
+   const uint64_t copied_span = (uint64_t)(extent.height - 1) * pitch +
+                                (uint64_t)extent.width * block_size;
+   const uint32_t max_elements =
+      cmd->device->physical_device->info->props.max_texel_buffer_range_elements;
+   if (src_va % block_size || copied_span > UINT32_MAX ||
+       copied_span / block_size > max_elements) {
