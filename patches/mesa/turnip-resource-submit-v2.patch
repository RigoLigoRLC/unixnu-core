+static VkResult
+darwin_add_native_range(struct tu_darwin_queue_submit *submit, struct tu_bo *bo,
+                       uint64_t offset, uint64_t bytes, uint32_t access)
+{
+   if (bo->darwin_alloc_flags & TU_BO_ALLOC_GPU_READ_ONLY)
+      access &= ~TU_RESOURCE_WRITE;
+   if (!access)
+      return VK_SUCCESS;
+
+   NativeAdrenoAbiSubmitResourceV2 *range = (NativeAdrenoAbiSubmitResourceV2 *)
+      util_dynarray_grow(&submit->native_ranges, NativeAdrenoAbiSubmitResourceV2, 1);
+   if (!range)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+
+   *range = {bo->darwin_handle, offset, bytes, access, 0};
+   return VK_SUCCESS;
+}
