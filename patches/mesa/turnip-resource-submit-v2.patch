diff --git a/src/freedreno/vulkan/tu_cmd_buffer.cc b/src/freedreno/vulkan/tu_cmd_buffer.cc
index bcb7724..43fb96e 100644
--- a/src/freedreno/vulkan/tu_cmd_buffer.cc
+++ b/src/freedreno/vulkan/tu_cmd_buffer.cc
@@ -33,6 +33,127 @@ enum tu_cmd_buffer_status {
    TU_CMD_BUFFER_STATUS_ACTIVE = 1,
 };
 
+void
+tu_cmd_use_range(struct tu_cmd_buffer *cmd, struct tu_resource_range range)
+{
+#ifdef TU_HAS_DARWIN
+   if (!range.iova || !range.size)
+      return;
+
+   const uint32_t count = util_dynarray_num_elements(&cmd->resource_ranges, struct tu_resource_range);
+   struct tu_resource_range *ranges = (struct tu_resource_range *)cmd->resource_ranges.data;
+   for (uint32_t i = count; i > 0 && count - i < 16; i--) {
+      if (ranges[i - 1].iova == range.iova && ranges[i - 1].size == range.size) {
+         ranges[i - 1].access |= range.access;
+         return;
+      }
+   }
+
+   struct tu_resource_range *record = (struct tu_resource_range *)
+      util_dynarray_grow(&cmd->resource_ranges, struct tu_resource_range, 1);
+   if (!record) {
+      vk_command_buffer_set_error(&cmd->vk, VK_ERROR_OUT_OF_HOST_MEMORY);
+      return;
+   }
+
+   *record = range;
+#endif
+}
+
+void
+tu_cmd_use_bo(struct tu_cmd_buffer *cmd, const struct tu_bo *bo, uint32_t access)
+{
+   if (bo)
+      tu_cmd_use_range(cmd, {bo->iova, bo->size, access});
+}
+
+static void
+tu_cmd_use_shader(struct tu_cmd_buffer *cmd, const struct tu_shader *shader)
+{
+   if (!shader)
+      return;
+
+   tu_cmd_use_range(cmd, {shader->bo.iova, shader->bo.size, TU_RESOURCE_READ});
+   tu_cmd_use_bo(cmd, shader->pvtmem_bo, TU_RESOURCE_READ | TU_RESOURCE_WRITE);
+}
+
+void
+tu_cmd_use_buffer(struct tu_cmd_buffer *cmd, const struct tu_buffer *buffer,
+                  uint32_t access)
+{
+   if (!buffer)
+      return;
+
+   if (buffer->vk.create_flags & VK_BUFFER_CREATE_SPARSE_BINDING_BIT) {
+      cmd->resource_fallback_reasons |= TU_RESOURCE_FALLBACK_SPARSE;
+      return;
+   }
+
+   tu_cmd_use_range(cmd, {buffer->vk.device_address, buffer->vk.size, access});
+}
+
+void
+tu_cmd_use_image(struct tu_cmd_buffer *cmd, const struct tu_image *image,
+                 uint32_t access)
+{
+   if (!image)
+      return;
+
+   if (image->vk.create_flags & VK_IMAGE_CREATE_SPARSE_BINDING_BIT) {
+      cmd->resource_fallback_reasons |= TU_RESOURCE_FALLBACK_SPARSE;
+      return;
+   }
+
+   tu_cmd_use_range(cmd, {image->iova, image->total_size, access});
+}
+
+VkResult
+tu_cmd_record_result(struct tu_cmd_buffer *cmd)
+{
+   struct tu_cs *streams[] = {
+      &cmd->cs, &cmd->draw_cs, &cmd->tile_store_cs,
+      &cmd->draw_epilogue_cs, &cmd->sub_cs,
+      &cmd->pre_chain.draw_cs, &cmd->pre_chain.draw_epilogue_cs,
+   };
+   for (struct tu_cs *cs : streams) {
+      VkResult result = tu_cs_get_record_result(cs);
+      if (result != VK_SUCCESS)
+         vk_command_buffer_set_error(&cmd->vk, result);
+   }
+
+   return vk_command_buffer_get_record_result(&cmd->vk);
+}
+
+static void
+tu_cmd_use_descriptor_set(struct tu_cmd_buffer *cmd, struct tu_descriptor_set *set)
+{
+#ifdef TU_HAS_DARWIN
+   tu_cmd_use_range(cmd, {set->va, set->size, TU_RESOURCE_READ});
+   if (set->layout->flags & VK_DESCRIPTOR_SET_LAYOUT_CREATE_PUSH_DESCRIPTOR_BIT_KHR) {
+      for (uint32_t i = 0; i < set->resource_count; i++) {
+         tu_cmd_use_range(cmd, set->resources[i]);
+      }
+      if (set->resource_addresses_unknown) {
+         cmd->resource_fallback_reasons |= TU_RESOURCE_FALLBACK_DEVICE_ADDRESS;
+      }
+   } else {
+      struct tu_descriptor_set **record = (struct tu_descriptor_set **)
+         util_dynarray_grow(&cmd->resource_descriptor_sets, struct tu_descriptor_set *, 1);
+      if (!record) {
+         vk_command_buffer_set_error(&cmd->vk, VK_ERROR_OUT_OF_HOST_MEMORY);
+         return;
+      }
+
+      *record = set;
+   }
+
+   if (set->layout->binding_flags & (VK_DESCRIPTOR_BINDING_UPDATE_AFTER_BIND_BIT |
+                                     VK_DESCRIPTOR_BINDING_UPDATE_UNUSED_WHILE_PENDING_BIT)) {
+      cmd->resource_fallback_reasons |= TU_RESOURCE_FALLBACK_UPDATE_AFTER_BIND;
+   }
+#endif
+}
