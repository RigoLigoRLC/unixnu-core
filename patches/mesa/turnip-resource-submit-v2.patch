+darwin_submit_caps(struct tu_device *dev)
+{
+   struct darwin_connection *connection = darwin_connection_for(dev);
+   pthread_mutex_lock(&connection->lock);
+   const bool checked = connection->submit_caps_checked;
+   NativeAdrenoAbiSubmitCaps caps = connection->submit_caps;
+   pthread_mutex_unlock(&connection->lock);
+   if (checked)
+      return caps;
