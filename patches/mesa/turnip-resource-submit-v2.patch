+darwin_publish_resource_fence(struct tu_darwin_queue_submit *submit, uint32_t fence)
+{
+   util_dynarray_foreach (&submit->resources, struct darwin_submit_resource, resource) {
+      p_atomic_set(&resource->bo->darwin_last_fence, fence);
+   }
+}
