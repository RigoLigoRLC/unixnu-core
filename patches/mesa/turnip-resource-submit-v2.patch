+/* The completed cache releases enough mappings to fit this connection's
+ * share after already queued destruction has finished. Active and pending
+ * BOs keep their storage until their owners and GPU jobs release it. */
+static void
+darwin_enforce_mapping_budget_locked(struct darwin_retire_state *retire)
+{
+   const unsigned target = retire->mapping_budget.version ?
+      MIN2(retire->mapping_budget.connection_target, (uint32_t) DARWIN_NATIVE_BO_LIMIT) :
+      DARWIN_NATIVE_BO_LIMIT / 2;
+   unsigned retained = retire->node_count - retire->reclaim_count - retire->released_count;
+   while (retire->cache_count && retained > target) {
+      darwin_evict_oldest_locked(retire, DARWIN_EVICT_OBJECTS);
+      --retained;
+   }
+}
