+void
+tu_cs_use_range(struct tu_cs *cs, uint64_t iova, uint64_t bytes, uint32_t access)
+{
+#ifdef TU_HAS_DARWIN
+   if (!iova || !bytes || cs->record_result != VK_SUCCESS)
+      return;
+
+   while (cs->parent) {
+      cs = cs->parent;
+   }
+   if (cs->mode == TU_CS_MODE_EXTERNAL)
+      return;
+
+   const uint32_t count = util_dynarray_num_elements(&cs->resource_ranges, struct tu_resource_range);
+   struct tu_resource_range *ranges = (struct tu_resource_range *)cs->resource_ranges.data;
+   for (uint32_t i = count; i > 0 && count - i < 16; i--) {
+      if (ranges[i - 1].iova == iova && ranges[i - 1].size == bytes) {
+         ranges[i - 1].access |= access;
+         return;
+      }
+   }
+
+   struct tu_resource_range *range = (struct tu_resource_range *)
+      util_dynarray_grow(&cs->resource_ranges, struct tu_resource_range, 1);
+   if (!range) {
+      tu_cs_set_error(cs, VK_ERROR_OUT_OF_HOST_MEMORY);
+      return;
+   }
+   *range = {iova, bytes, access};
+#endif
+}
+
+void
+tu_cs_use_resources(struct tu_cs *cs, const struct tu_cs *target)
+{
+#ifdef TU_HAS_DARWIN
+   while (cs->parent) {
+      cs = cs->parent;
+   }
+   if (cs == target)
+      return;
+
+   util_dynarray_foreach (&target->resource_ranges, struct tu_resource_range, range) {
+      tu_cs_use_range(cs, range->iova, range->size, range->access);
+   }
+#endif
