+/* A new BO keeps its handle, IOVA and metadata ID across bounded retries.
+ * Only the retirement worker destroys completed cached mappings. A failed
+ * retry returns all three reservations through darwin_map_failure. */
+static VkResult
+darwin_map_storage(struct tu_device *dev, uint64_t handle, uint64_t iova,
+                   uint64_t size, uint32_t gem_handle, uint32_t permissions)
+{
+   struct darwin_connection &dw = *darwin_connection_for(dev);
+   NativeAdrenoAbiBoMap map = {
+      .handle = handle,
+      .iova = iova,
+      .permissions = permissions,
+      .writeback = 0,
+      .shareability = 2,
+   };
+   NativeAdrenoAbiBoMapReply mapped = {};
+   const uint64_t deadline_ns = os_time_get_nano() + 5000000000ull;
+   kern_return_t kr = darwin_map_with_alias_wait(dev, &map, &mapped, deadline_ns);
+   const bool mapping_pressure = kr == kIOReturnNoSpace &&
+      (dw.params.flags & NativeAdrenoParamsResourceBudget);
+   if (mapping_pressure || kr == kIOReturnNoResources) {
+      darwin_refresh_mapping_budget(dev, true);
+      VkResult reclaimed = darwin_trim_cache(dev, DARWIN_EVICT_OBJECTS);
+      if (reclaimed != VK_SUCCESS) {
+         VkResult cleanup = darwin_map_failure(dev, handle, iova, size, gem_handle, kr);
+         return cleanup == VK_ERROR_DEVICE_LOST ? cleanup : reclaimed;
+      }
+      const unsigned attempts = mapping_pressure ? 3 : 1;
+      for (unsigned attempt = 0; attempt < attempts; ++attempt) {
+         kr = darwin_map_with_alias_wait(dev, &map, &mapped, deadline_ns);
+         if (kr != kIOReturnNoSpace || attempt + 1 == attempts) {
+            break;
+         }
+
+         struct darwin_retire_state *retire = (struct darwin_retire_state *)dev->darwin_retire;
+         struct timespec deadline;
+         clock_gettime(CLOCK_REALTIME, &deadline);
+         deadline.tv_nsec += 100000000;
+         if (deadline.tv_nsec >= 1000000000) {
+            ++deadline.tv_sec;
+            deadline.tv_nsec -= 1000000000;
+         }
+         pthread_mutex_lock(&retire->lock);
+         if (!retire->worker_stop && retire->failure == VK_SUCCESS) {
+            pthread_cond_timedwait(&retire->progress, &retire->lock, &deadline);
+         }
+         pthread_mutex_unlock(&retire->lock);
+         darwin_refresh_mapping_budget(dev, true);
+      }
+   }
+
+   if (kr != KERN_SUCCESS) {
+      return darwin_map_failure(dev, handle, iova, size, gem_handle, kr);
+   }
+
+   return VK_SUCCESS;
+}
