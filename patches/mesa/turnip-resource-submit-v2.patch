+static kern_return_t
+darwin_map_with_alias_wait(struct tu_device *dev, const NativeAdrenoAbiBoMap *map,
+                           NativeAdrenoAbiBoMapReply *mapped, uint64_t deadline_ns)
+{
+   struct darwin_connection &dw = *darwin_connection_for(dev);
+   for (;;) {
+      kern_return_t kr = dw_call(dev, NativeAdrenoMethodBoMap, map, sizeof(*map),
+                                 mapped, sizeof(*mapped));
+      if (kr != kIOReturnBusy || os_time_get_nano() >= deadline_ns ||
+          !(dw.params.flags & NativeAdrenoParamsResourceBudget)) {
+         return kr;
+      }
+
+      NativeAdrenoAbiResourceBudget budget = {};
+      kern_return_t queried = dw_call(dev, NativeAdrenoMethodGetResourceBudget,
+                                      NULL, 0, &budget, sizeof(budget));
+      if (queried != KERN_SUCCESS || budget.version != NativeAdrenoResourceBudgetVersion ||
+          budget.last_failure_reason != NativeAdrenoMapFailureActiveAlias ||
+          budget.last_failure_handle != map->handle || budget.last_failure_iova != map->iova) {
+         return kr;
+      }
+
+      pthread_mutex_lock(&dw.lock);
+      const uint32_t fence = dw.last_fence;
+      pthread_mutex_unlock(&dw.lock);
+      if (fence) {
+         VkResult waited = dw_wait_fence_raw(dev, fence,
+            MIN2(deadline_ns, (uint64_t)os_time_get_nano() + 1000000));
+         if (waited != VK_SUCCESS && waited != VK_TIMEOUT) {
+            return kIOReturnNotResponding;
+         }
+         if (waited == VK_TIMEOUT) {
+            continue;
+         }
+      }
+
+      const uint64_t now = os_time_get_nano();
+      if (now < deadline_ns) {
+         usleep((useconds_t) MIN2(1000ull, (deadline_ns - now + 999) / 1000));
+      }
+   }
+}
