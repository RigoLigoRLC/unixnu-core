+static VkResult
+darwin_submit_v2(struct tu_queue *queue, struct tu_darwin_queue_submit *submit,
+                  const NativeAdrenoAbiSubmitCaps &caps, uint32_t *fence)
+{
+   struct tu_device *dev = queue->device;
+   struct darwin_connection &dw = *darwin_connection_for(dev);
+   const uint32_t ib_count = util_dynarray_num_elements(&submit->commands, NativeAdrenoAbiSubmitBuffer);
+   const uint32_t resource_count = util_dynarray_num_elements(&submit->resources, struct darwin_submit_resource);
+   const size_t bytes = sizeof(NativeAdrenoAbiSubmitV2) +
+      ib_count * sizeof(NativeAdrenoAbiSubmitIbV2) +
+      resource_count * sizeof(NativeAdrenoAbiSubmitResourceV2);
+   if (ib_count > caps.max_ibs || resource_count > caps.max_resources || bytes > caps.max_packet_bytes) {
+      return vk_errorf(dev, VK_ERROR_OUT_OF_HOST_MEMORY, "native submit exceeds advertised resource or IB limit");
+   }
+
+   uint8_t *packet = (uint8_t *)vk_zalloc(&dev->vk.alloc, bytes + 8, 8,
+                                         VK_SYSTEM_ALLOCATION_SCOPE_COMMAND);
+   if (!packet)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+
+   ((uint32_t *)packet)[0] = DW_TUNNEL_MAGIC;
+   ((uint32_t *)packet)[1] = NativeAdrenoMethodSubmitV2;
+   NativeAdrenoAbiSubmitV2 *header = (NativeAdrenoAbiSubmitV2 *)(packet + 8);
+   header->version = NativeAdrenoSubmitVersion;
+   header->header_bytes = sizeof(*header);
+   header->total_bytes = bytes;
+   header->ib_count = ib_count;
+   header->resource_count = resource_count;
+   header->ib_offset = sizeof(*header);
+   header->resource_offset = header->ib_offset + ib_count * sizeof(NativeAdrenoAbiSubmitIbV2);
+   header->epoch = caps.epoch;
+   if (submit->fallback_reasons) {
+      header->flags = NativeAdrenoSubmitAllMapped;
+      if (submit->fallback_reasons & TU_RESOURCE_FALLBACK_DEVICE_ADDRESS)
+         header->fallback_reason |= NativeAdrenoFallbackDeviceAddress;
+      if (submit->fallback_reasons & TU_RESOURCE_FALLBACK_DESCRIPTOR_BUFFER)
+         header->fallback_reason |= NativeAdrenoFallbackDescriptorBuffer;
+      if (submit->fallback_reasons & (TU_RESOURCE_FALLBACK_SPARSE | TU_RESOURCE_FALLBACK_UPDATE_AFTER_BIND))
+         header->fallback_reason |= NativeAdrenoFallbackIncompleteTracking;
+   }
+
+   NativeAdrenoAbiSubmitIbV2 *ibs = (NativeAdrenoAbiSubmitIbV2 *)((uint8_t *)header + header->ib_offset);
+   NativeAdrenoAbiSubmitResourceV2 *resources =
+      (NativeAdrenoAbiSubmitResourceV2 *)((uint8_t *)header + header->resource_offset);
+   const struct darwin_submit_resource *objects = (const struct darwin_submit_resource *)submit->resources.data;
+   const NativeAdrenoAbiSubmitBuffer *commands = (const NativeAdrenoAbiSubmitBuffer *)submit->commands.data;
+   for (uint32_t i = 0; i < resource_count; i++) {
+      resources[i] = {objects[i].bo->darwin_handle, 0, objects[i].bo->size, objects[i].access, 0};
+   }
+   for (uint32_t i = 0; i < ib_count; i++) {
+      uint32_t resource = 0;
+      while (resource < resource_count && objects[resource].bo->darwin_handle != commands[i].handle)
+         resource++;
+      if (resource == resource_count) {
+         vk_free(&dev->vk.alloc, packet);
+         return vk_device_set_lost(&dev->vk, "native IB has no live retained BO");
+      }
+      ibs[i] = {resource, 0, commands[i].iova - objects[resource].bo->iova, commands[i].bytes};
+   }
+
+   VkResult result = VK_SUCCESS;
+   const uint64_t deadline = os_time_get_nano() + 5000000000ull;
+   for (;;) {
+      NativeAdrenoAbiSubmitV2Reply reply = {};
+      size_t output_size = sizeof(reply);
+      const kern_return_t status = IOConnectCallStructMethod(dw.conn,
+         dw.tunnel ? dw.selector : NativeAdrenoMethodSubmitV2,
+         dw.tunnel ? (void *)packet : (void *)header, bytes + (dw.tunnel ? 8 : 0),
+         &reply, &output_size);
+      if (status == KERN_SUCCESS) {
+         if (reply.epoch != caps.epoch || !reply.fence || reply.fence > UINT32_MAX) {
+            result = vk_device_set_lost(&dev->vk, "native submit returned an invalid completion identity");
+         } else {
+            *fence = reply.fence;
+         }
+         break;
+      }
+      if (status != kIOReturnBusy) {
+         result = vk_device_set_lost(&dev->vk, "native submit V2 failed: 0x%x", status);
+         break;
+      }
+      if (os_time_get_nano() >= deadline) {
+         result = vk_device_set_lost(&dev->vk, "native submit waited five seconds for resource retirement");
+         break;
+      }
+
+      pthread_mutex_lock(&dw.lock);
+      const uint32_t oldest = dw.inflight_count ? dw.inflight[0] : 0;
+      pthread_mutex_unlock(&dw.lock);
+      if (oldest) {
+         result = dw_wait_fence_locked_free(dev, oldest, deadline);
+         if (result != VK_SUCCESS)
+            break;
+      }
+      usleep(100);
+   }
+
+   vk_free(&dev->vk.alloc, packet);
+   return result;
+}
