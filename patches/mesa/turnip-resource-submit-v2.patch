+VkResult
+tu_darwin_submit_add_resources(struct tu_device *dev, void *_submit,
+                               struct tu_cmd_buffer *cmd)
+{
+   struct tu_darwin_queue_submit *submit = (struct tu_darwin_queue_submit *)_submit;
+   submit->fallback_reasons |= cmd->resource_fallback_reasons;
+
+   const size_t count = util_dynarray_num_elements(&cmd->resource_ranges, struct tu_resource_range);
+   if (count) {
+      void *target = util_dynarray_grow_bytes(&submit->ranges, count, sizeof(struct tu_resource_range));
+      if (!target)
+         return submit->result = VK_ERROR_OUT_OF_HOST_MEMORY;
+
+      memcpy(target, cmd->resource_ranges.data, count * sizeof(struct tu_resource_range));
+   }
+
+   util_dynarray_foreach (&cmd->resource_descriptor_sets, struct tu_descriptor_set *, set_ptr) {
+      const struct tu_descriptor_set *set = *set_ptr;
+      if (set->layout->flags & VK_DESCRIPTOR_SET_LAYOUT_CREATE_UPDATE_AFTER_BIND_POOL_BIT) {
+         submit->fallback_reasons |= TU_RESOURCE_FALLBACK_UPDATE_AFTER_BIND;
+         continue;
+      }
+      if (set->resource_addresses_unknown)
+         submit->fallback_reasons |= TU_RESOURCE_FALLBACK_DEVICE_ADDRESS;
+      if (!set->resource_count)
+         continue;
+
+      void *target = util_dynarray_grow_bytes(&submit->ranges, set->resource_count, sizeof(*set->resources));
+      if (!target)
+         return submit->result = VK_ERROR_OUT_OF_HOST_MEMORY;
+
+      memcpy(target, set->resources, set->resource_count * sizeof(*set->resources));
+   }
+   return submit->result;
+}
