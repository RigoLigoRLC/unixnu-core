+static struct tu_resource_range
+descriptor_resource(VkDescriptorType type, const void *data, bool *unknown)
+{
+   const struct tu_buffer *buffer = NULL;
+   const struct tu_image *image = NULL;
+   uint32_t access = TU_RESOURCE_READ;
+
+   switch (type) {
+   case VK_DESCRIPTOR_TYPE_STORAGE_BUFFER:
+   case VK_DESCRIPTOR_TYPE_STORAGE_BUFFER_DYNAMIC:
+      access |= TU_RESOURCE_WRITE;
+      FALLTHROUGH;
+   case VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER:
+   case VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER_DYNAMIC:
+      buffer = tu_buffer_from_handle(((const VkDescriptorBufferInfo *)data)->buffer);
+      break;
+   case VK_DESCRIPTOR_TYPE_STORAGE_TEXEL_BUFFER:
+      access |= TU_RESOURCE_WRITE;
+      FALLTHROUGH;
+   case VK_DESCRIPTOR_TYPE_UNIFORM_TEXEL_BUFFER: {
+      const struct tu_buffer_view *view =
+         tu_buffer_view_from_handle(*(const VkBufferView *)data);
+      buffer = view ? view->buffer : NULL;
+      break;
+   }
+   case VK_DESCRIPTOR_TYPE_STORAGE_IMAGE:
+      access |= TU_RESOURCE_WRITE;
+      FALLTHROUGH;
+   case VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE:
+   case VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER:
+   case VK_DESCRIPTOR_TYPE_INPUT_ATTACHMENT:
+   case VK_DESCRIPTOR_TYPE_SAMPLE_WEIGHT_IMAGE_QCOM:
+   case VK_DESCRIPTOR_TYPE_BLOCK_MATCH_IMAGE_QCOM: {
+      const struct tu_image_view *view =
+         tu_image_view_from_handle(((const VkDescriptorImageInfo *)data)->imageView);
+      image = view ? view->image : NULL;
+      break;
+   }
+   case VK_DESCRIPTOR_TYPE_SAMPLER:
+   case VK_DESCRIPTOR_TYPE_INLINE_UNIFORM_BLOCK:
+      break;
+   default:
+      *unknown = true;
+      break;
+   }
+
+   if (buffer) {
+      if (buffer->vk.create_flags & VK_BUFFER_CREATE_SPARSE_BINDING_BIT)
+         *unknown = true;
+      return {buffer->vk.device_address, buffer->vk.size, access};
+   }
+   if (image) {
+      if (image->vk.create_flags & VK_IMAGE_CREATE_SPARSE_BINDING_BIT)
+         *unknown = true;
+      return {image->iova, image->total_size, access};
+   }
+   return {};
+}
+
+static void
+set_descriptor_resource(struct tu_descriptor_set *set, uint32_t index,
+                        VkDescriptorType type, const void *data)
+{
+   if (!set->resources || index >= set->resource_count) {
+      set->resource_addresses_unknown = true;
+      return;
+   }
+
+   set->resources[index] = descriptor_resource(type, data,
+                                              &set->resource_addresses_unknown);
+}
