+static VkResult
+darwin_collect_submit_resources(struct tu_device *dev, struct tu_darwin_queue_submit *submit,
+                                bool legacy)
+{
+   struct darwin_retire_state *retire = (struct darwin_retire_state *)dev->darwin_retire;
+   struct darwin_submit_resource *objects = (struct darwin_submit_resource *)
+      util_dynarray_grow(&submit->resources, struct darwin_submit_resource, DARWIN_NATIVE_BO_LIMIT);
+   if (!objects)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+
+   uint32_t count = 0;
+   pthread_mutex_lock(&retire->lock);
+   for (uint32_t id = 1; id <= DARWIN_NATIVE_BO_LIMIT; id++) {
+      if (retire->nodes[id].state != DARWIN_BO_ACTIVE)
+         continue;
+
+      struct tu_bo *bo = tu_device_lookup_bo(dev, id);
+      objects[count++] = {tu_bo_get_ref(bo), 0};
+   }
+   pthread_mutex_unlock(&retire->lock);
+   submit->resources.size = count * sizeof(*objects);
+   qsort(objects, count, sizeof(*objects), darwin_resource_compare);
+
+   util_dynarray_foreach (&submit->commands, NativeAdrenoAbiSubmitBuffer, ib) {
+      struct tu_resource_range *range = (struct tu_resource_range *)
+         util_dynarray_grow(&submit->ranges, struct tu_resource_range, 1);
+      if (!range)
+         return VK_ERROR_OUT_OF_HOST_MEMORY;
+
+      *range = {ib->iova, ib->bytes, TU_RESOURCE_READ};
+   }
+
+   util_dynarray_foreach (&submit->ranges, struct tu_resource_range, range) {
+      if (!range->iova || !range->size)
+         continue;
+
+      uint32_t lo = 0, hi = count;
+      while (lo < hi) {
+         const uint32_t mid = lo + (hi - lo) / 2;
+         if (objects[mid].bo->iova <= range->iova)
+            lo = mid + 1;
+         else
+            hi = mid;
+      }
+      if (!lo || range->iova - objects[lo - 1].bo->iova >= objects[lo - 1].bo->size ||
+          range->size > objects[lo - 1].bo->size - (range->iova - objects[lo - 1].bo->iova)) {
+         submit->fallback_reasons |= TU_RESOURCE_FALLBACK_DEVICE_ADDRESS;
+         continue;
+      }
+      objects[lo - 1].access |= range->access;
+   }
+
+   uint32_t kept = 0;
+   for (uint32_t i = 0; i < count; i++) {
+      struct darwin_submit_resource resource = objects[i];
+      if (legacy || submit->fallback_reasons ||
+          (resource.bo->darwin_alloc_flags & TU_BO_ALLOC_INTERNAL_RESOURCE)) {
+         resource.access |= TU_RESOURCE_READ | TU_RESOURCE_WRITE;
+      }
+      if (resource.bo->darwin_alloc_flags & TU_BO_ALLOC_GPU_READ_ONLY)
+         resource.access &= ~TU_RESOURCE_WRITE;
+
+      if (resource.access) {
+         objects[kept++] = resource;
+      } else {
+         tu_bo_finish(dev, resource.bo);
+      }
+   }
+   submit->resources.size = kept * sizeof(*objects);
+   return VK_SUCCESS;
+}
