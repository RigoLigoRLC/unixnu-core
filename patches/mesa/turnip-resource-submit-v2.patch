+                                bool legacy)
+{
+   struct darwin_retire_state *retire = (struct darwin_retire_state *)dev->darwin_retire;
+   uint16_t object_indices[DARWIN_NATIVE_BO_LIMIT + 1] = {};
+
+   util_dynarray_foreach (&submit->commands, NativeAdrenoAbiSubmitBuffer, ib) {
+      struct tu_resource_range *range = (struct tu_resource_range *)
+         util_dynarray_grow(&submit->ranges, struct tu_resource_range, 1);
+      if (!range)
+         return VK_ERROR_OUT_OF_HOST_MEMORY;
+
+      *range = {ib->iova, ib->bytes, TU_RESOURCE_READ};
+   }
+
+   VkResult result = VK_SUCCESS;
+   pthread_mutex_lock(&retire->lock);
+   util_dynarray_foreach (&submit->ranges, struct tu_resource_range, range) {
+      if (!range->iova || !range->size)
+         continue;
+
+      struct tu_bo *bo = darwin_lookup_bo_locked(retire, range->iova, range->size);
+      if (!bo) {
+         submit->fallback_reasons |= TU_RESOURCE_FALLBACK_DEVICE_ADDRESS;
+         continue;
+      }
+      if (!object_indices[bo->gem_handle]) {
+         struct darwin_submit_resource *object = (struct darwin_submit_resource *)
+            util_dynarray_grow(&submit->resources, struct darwin_submit_resource, 1);
+         if (!object) {
+            result = VK_ERROR_OUT_OF_HOST_MEMORY;
+            break;
+         }
+         *object = {tu_bo_get_ref(bo), range->access};
+         object_indices[bo->gem_handle] =
+            util_dynarray_num_elements(&submit->resources, struct darwin_submit_resource);
+      }
+
+      result = darwin_add_native_range(submit, bo, range->iova - bo->iova,
+                                       range->size, range->access);
+      if (result != VK_SUCCESS)
+         break;
+   }
+
+   if (result == VK_SUCCESS && (legacy || submit->fallback_reasons)) {
+      for (uint32_t id = 1; id <= DARWIN_NATIVE_BO_LIMIT; id++) {
+         if (retire->nodes[id].state != DARWIN_BO_ACTIVE || object_indices[id])
+            continue;
+
+         struct tu_bo *bo = tu_device_lookup_bo(dev, id);
+         struct darwin_submit_resource *object = (struct darwin_submit_resource *)
+            util_dynarray_grow(&submit->resources, struct darwin_submit_resource, 1);
+         if (!object) {
+            result = VK_ERROR_OUT_OF_HOST_MEMORY;
+            break;
+         }
+         *object = {tu_bo_get_ref(bo), TU_RESOURCE_READ | TU_RESOURCE_WRITE};
+      }
