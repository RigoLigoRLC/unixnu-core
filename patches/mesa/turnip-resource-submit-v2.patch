+VKAPI_ATTR VkBool32 VKAPI_CALL
+tu_NativeAdrenoDeviceCacheMaintenance(VkDevice _device)
+{
+   VK_FROM_HANDLE(tu_device, device, _device);
+   if (!device->darwin_retire)
+      return VK_FALSE;
+
+   const NativeAdrenoAbiSubmitCaps caps = darwin_submit_caps(device);
+   return caps.version == NativeAdrenoSubmitVersion &&
+          (caps.flags & NativeAdrenoSubmitKernelCacheMaintenance) != 0;
+}
