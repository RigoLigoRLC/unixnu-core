+static void
+darwin_refresh_mapping_budget(struct tu_device *dev, bool force)
+{
+   struct darwin_retire_state *retire = (struct darwin_retire_state *)dev->darwin_retire;
+   if (!retire || !(retire->connection.params.flags & NativeAdrenoParamsResourceBudget)) {
+      return;
+   }
+
+   pthread_mutex_lock(&retire->lock);
+   const bool query = force || !(retire->budget_calls++ % 32);
+   pthread_mutex_unlock(&retire->lock);
+   if (!query) {
+      return;
+   }
+
+   NativeAdrenoAbiResourceBudget budget = {};
+   kern_return_t kr = dw_call(dev, NativeAdrenoMethodGetResourceBudget, NULL, 0,
+                              &budget, sizeof(budget));
+   if (kr != KERN_SUCCESS || budget.version != NativeAdrenoResourceBudgetVersion ||
+       !budget.capacity || budget.connection_target > budget.capacity) {
+      return;
+   }
+
+   pthread_mutex_lock(&retire->lock);
+   if (!retire->mapping_budget.version || budget.generation >= retire->mapping_budget.generation) {
+      retire->mapping_budget = budget;
+      darwin_enforce_mapping_budget_locked(retire);
+      ++retire->work_generation;
+      pthread_cond_signal(&retire->work_wake);
+   }
+   pthread_mutex_unlock(&retire->lock);
+}
