+   if (dw_call(dev, NativeAdrenoMethodQuerySubmitV2, NULL, 0, &caps, sizeof(caps)) != KERN_SUCCESS ||
+       caps.version != NativeAdrenoSubmitVersion) {
+      caps = {};
+   }
