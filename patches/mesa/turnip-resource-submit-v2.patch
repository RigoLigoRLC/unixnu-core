+static int
+darwin_resource_compare(const void *left, const void *right)
+{
+   const struct darwin_submit_resource *a = (const struct darwin_submit_resource *)left;
+   const struct darwin_submit_resource *b = (const struct darwin_submit_resource *)right;
+   return a->bo->iova < b->bo->iova ? -1 : a->bo->iova > b->bo->iova;
+}
