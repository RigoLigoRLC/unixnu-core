+static int
+darwin_native_range_compare(const void *left, const void *right)
+{
+   const NativeAdrenoAbiSubmitResourceV2 *a = (const NativeAdrenoAbiSubmitResourceV2 *)left;
+   const NativeAdrenoAbiSubmitResourceV2 *b = (const NativeAdrenoAbiSubmitResourceV2 *)right;
+   if (a->handle != b->handle)
+      return a->handle < b->handle ? -1 : 1;
+   if (a->access != b->access)
+      return a->access < b->access ? -1 : 1;
+   return a->offset < b->offset ? -1 : a->offset > b->offset;
+}
