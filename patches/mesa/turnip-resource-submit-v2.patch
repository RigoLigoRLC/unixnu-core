+darwin_lookup_bo_locked(struct darwin_retire_state *retire, uint64_t iova, uint64_t bytes)
+{
+   struct rb_node *entry = retire->active_bos.root;
+   while (entry) {
+      struct darwin_bo_node *node = rb_node_data(struct darwin_bo_node, entry, active_iova);
+      if (iova < node->bo.iova) {
+         entry = entry->left;
+      } else if (iova - node->bo.iova >= node->bo.size) {
+         entry = entry->right;
+      } else {
+         if (!bytes || bytes > node->bo.size - (iova - node->bo.iova)) {
+            return NULL;
+         }
