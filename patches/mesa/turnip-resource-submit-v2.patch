+   pthread_mutex_unlock(&retire->lock);
+   if (result != VK_SUCCESS)
+      return result;
+
+   NativeAdrenoAbiSubmitResourceV2 *ranges =
+      (NativeAdrenoAbiSubmitResourceV2 *)submit->native_ranges.data;
+   const uint32_t range_count =
+      util_dynarray_num_elements(&submit->native_ranges, NativeAdrenoAbiSubmitResourceV2);
+   qsort(ranges, range_count, sizeof(*ranges), darwin_native_range_compare);
+   uint32_t merged = 0;
+   for (uint32_t i = 0; i < range_count; i++) {
+      if (merged && ranges[merged - 1].handle == ranges[i].handle &&
+          ranges[merged - 1].access == ranges[i].access &&
+          ranges[i].offset <= ranges[merged - 1].offset + ranges[merged - 1].bytes) {
+         const uint64_t end = MAX2(ranges[merged - 1].offset + ranges[merged - 1].bytes,
+                                  ranges[i].offset + ranges[i].bytes);
+         ranges[merged - 1].bytes = end - ranges[merged - 1].offset;
+      } else {
+         ranges[merged++] = ranges[i];
+      }
+   }
+   submit->native_ranges.size = merged * sizeof(*ranges);
+   return VK_SUCCESS;
+}
