diff --git a/src/freedreno/vulkan/tu_frame_diagnostic.h b/src/freedreno/vulkan/tu_frame_diagnostic.h
new file mode 100644
index 0000000..afff485
--- /dev/null
+++ b/src/freedreno/vulkan/tu_frame_diagnostic.h
@@ -0,0 +1,74 @@
+/* SPDX-License-Identifier: MIT */
+#pragma once
+
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifdef __APPLE__
+#include <sys/sysctl.h>
+
+extern "C" bool tu_darwin_frame_diagnostic(uint32_t, const void *, uint32_t);
+
+/* The render server sends bounded pass, attachment and GMEM transfer records
+ * to the kernel trace when SHENG_GPU_TRACE is enabled. */
+static inline bool
+tu_swap_trace_on()
+{
+   static const bool on = getenv("SHENG_GPU_TRACE") != nullptr && !strcmp(getprogname(), "backboardd");
+   return on;
+}
+
+static inline void
+tu_frame_event(uint32_t event, uint64_t a = 0, uint64_t b = 0, uint64_t c = 0,
+               uint64_t d = 0, uint64_t e = 0, uint64_t f = 0, uint64_t g = 0,
+               uint64_t h = 0, uint64_t i = 0, uint64_t j = 0, uint64_t k = 0,
+               uint64_t l = 0)
+{
+   if (!tu_swap_trace_on() || (event != 36 && event != 37 && event != 44)) {
+      return;
+   }
+
+   struct {
+      uint64_t seq, us;
+      uint32_t event, pid;
+      uint64_t values[12];
+   } record = {0, 0, event, 0, {a, b, c, d, e, f, g, h, i, j, k, l}};
+   (void)tu_darwin_frame_diagnostic(0x7102, &record, sizeof(record));
+}
+
+/* The sheng-tum boot argument selects GMEM ('g') or strict system memory
+ * ('s') for colour capture. Zero leaves the ordinary render-mode policy. */
+static inline char
+tu_sheng_render_mode()
+{
+   static const char mode = [] {
+      char args[1100] = {};
+      size_t size = sizeof(args) - 1;
+      const char *at = sysctlbyname("kern.bootargs", args, &size, nullptr, 0) == 0 ?
+         strstr(args, "sheng-tum=") : nullptr;
+      return at && (at[10] == 'g' || at[10] == 's') ? at[10] : char(0);
+   }();
+   return mode;
+}
+#else
+static inline char
+tu_sheng_render_mode()
+{
+   return 0;
+}
+
+static inline bool
+tu_swap_trace_on()
+{
+   return false;
+}
+
+static inline void
+tu_frame_event(uint32_t, uint64_t = 0, uint64_t = 0, uint64_t = 0,
+               uint64_t = 0, uint64_t = 0, uint64_t = 0, uint64_t = 0,
+               uint64_t = 0, uint64_t = 0, uint64_t = 0, uint64_t = 0,
+               uint64_t = 0)
+{
+}
+#endif
