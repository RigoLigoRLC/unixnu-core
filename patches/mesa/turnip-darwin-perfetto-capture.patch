diff --git a/src/freedreno/vulkan/tu_darwin_trace.cc b/src/freedreno/vulkan/tu_darwin_trace.cc
--- /dev/null
+++ b/src/freedreno/vulkan/tu_darwin_trace.cc
@@ -0,0 +1,744 @@
+/* SPDX-License-Identifier: MIT */
+#include "tu_darwin_trace.h"
+
+#if __has_include("NativeAdrenoTrace.h")
+#include <mach/mach_time.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+
+#include "NativeAdrenoTrace.h"
+#include "tu_cmd_buffer.h"
+#include "tu_device.h"
+#include "tu_queue.h"
+#include "tu_tracepoints.h"
+#include "util/u_atomic.h"
+
+enum {
+   TRACE_LOCAL_EVENTS = 4096,
+   TRACE_MEMORY_BYTES = 16 * 1024 * 1024,
+   TRACE_END_BYTES = 4096,
+};
+
+static uint64_t trace_next_command;
+
+/* tu_darwin_trace_state owns one device's bounded CPU event queue. The u_trace
+ * worker supplies completed GPU timestamps; Metal supplies command metadata.
+ * The transport thread polls capture control, sends batches, and releases its
+ * producer after admitted submissions retire and their events are sent. */
+struct tu_darwin_trace_state {
+   struct tu_device *device;
+   pthread_t worker;
+   pthread_mutex_t mutex;
+   pthread_cond_t changed;
+   bool stop;
+   uint32_t active_generation;
+   NativeAdrenoTraceProducer producer;
+   NativeAdrenoTraceEvent events[TRACE_LOCAL_EVENTS];
+   uint32_t head;
+   uint32_t count;
+   uint32_t dropped;
+   uint32_t budget_dropped;
+   uint32_t queue_dropped;
+   uint32_t append_dropped;
+   uint32_t unsubmitted_commands;
+   uint32_t unexecuted_gmem_points;
+   uint64_t reserved_bytes;
+   uint64_t reserved_bytes_peak;
+   uint32_t pending_commands;
+   uint32_t pending_submissions;
+   bool end_records_written;
+   uint64_t timestamp_dwords;
+   uint64_t copy_dwords;
+   uint64_t wait_dwords;
+   uint64_t stage_commands[12];
+   mach_timebase_info_data_t timebase;
+};
+
+static tu_darwin_trace_state *
+trace_state(struct tu_device *device)
+{
+   return (tu_darwin_trace_state *)device->darwin_trace;
+}
+
+static uint64_t
+trace_now(tu_darwin_trace_state *state)
+{
+   const uint64_t ticks = mach_absolute_time();
+   return (ticks / state->timebase.denom) * state->timebase.numer +
+          (ticks % state->timebase.denom) * state->timebase.numer / state->timebase.denom;
+}
+
+static void
+trace_argument(NativeAdrenoTraceEvent *event, uint32_t key, uint64_t value)
+{
+   if (event->argument_count < 4) {
+      event->args[event->argument_count++] = {key, NativeAdrenoTraceArgumentUnsigned, value};
+   }
+}
+
+static NativeAdrenoTraceEvent
+trace_cpu_event(tu_darwin_trace_state *state, uint32_t point, const char *name)
+{
+   NativeAdrenoTraceEvent event = {};
+   event.source = NativeAdrenoTraceSourceTurnip;
+   event.point = point;
+   event.phase = NativeAdrenoTracePhaseInstant;
+   event.clock_domain = NativeAdrenoTraceClockMonotonicNanoseconds;
+   event.timestamp_ns = trace_now(state);
+   event.process_id = getpid();
+   snprintf(event.name, sizeof(event.name), "%s", name);
+   return event;
+}
+
+static void
+trace_append_locked(tu_darwin_trace_state *state, uint32_t generation,
+                    const NativeAdrenoTraceEvent &event)
+{
+   if (!state->producer.producer_id || generation != state->producer.generation) {
+      return;
+   }
+   if (state->count == TRACE_LOCAL_EVENTS) {
+      state->dropped++;
+      state->queue_dropped++;
+      return;
+   }
+
+   state->events[(state->head + state->count) % TRACE_LOCAL_EVENTS] = event;
+   state->count++;
+   pthread_cond_broadcast(&state->changed);
+}
+
+static void
+trace_append(tu_darwin_trace_state *state, uint32_t generation,
+              const NativeAdrenoTraceEvent &event)
+{
+   pthread_mutex_lock(&state->mutex);
+   trace_append_locked(state, generation, event);
+   pthread_mutex_unlock(&state->mutex);
+}
+
+static bool
+trace_accept(struct u_trace *trace, uint32_t count, uint32_t type, uint64_t allocation_bytes)
+{
+   tu_darwin_trace_state *state = trace_state((tu_device *)trace->utctx->pctx);
+   pthread_mutex_lock(&state->mutex);
+
+   /* Each begin reserves the enabled end payload and a new timestamp chunk. */
+   if (type == 1) {
+      bool accept = false;
+      if (trace->external_range_depth) {
+         const uint32_t depth = --trace->external_range_depth;
+         accept = depth < 64 && !(trace->external_rejected_ranges & (1ull << depth));
+      }
+      if (accept) {
+         state->reserved_bytes -= TRACE_END_BYTES;
+         trace->external_reserved_bytes -= TRACE_END_BYTES;
+         state->reserved_bytes += allocation_bytes;
+         trace->external_reserved_bytes += allocation_bytes;
+      }
+      pthread_mutex_unlock(&state->mutex);
+      return accept;
+   }
+
+   const uint64_t reserved = allocation_bytes + (type == 0 ? TRACE_END_BYTES : 0);
+   const bool active = trace->external_generation == p_atomic_read(&state->active_generation) &&
+                       trace->external_generation == state->producer.generation &&
+                       state->producer.producer_id;
+   const bool accept = active && state->reserved_bytes <= TRACE_MEMORY_BYTES &&
+                       reserved <= TRACE_MEMORY_BYTES - state->reserved_bytes &&
+                       (type != 0 || trace->external_range_depth < 64);
+   if (type == 0) {
+      const uint32_t depth = trace->external_range_depth++;
+      if (depth < 64) {
+         if (accept) {
+            trace->external_rejected_ranges &= ~(1ull << depth);
+         } else {
+            trace->external_rejected_ranges |= 1ull << depth;
+         }
+      }
+   }
+   if (accept) {
+      state->reserved_bytes += reserved;
+      trace->external_reserved_bytes += reserved;
+      state->reserved_bytes_peak = MAX2(state->reserved_bytes_peak, state->reserved_bytes);
+   } else if (active) {
+      const uint32_t dropped = type == 0 ? 2 : count;
+      state->dropped += dropped;
+      state->budget_dropped += dropped;
+   }
+   pthread_mutex_unlock(&state->mutex);
+   return accept;
+}
+
+static void
+trace_release_allocations(struct u_trace *trace)
+{
+   tu_darwin_trace_state *state = trace_state((tu_device *)trace->utctx->pctx);
+   pthread_mutex_lock(&state->mutex);
+   state->reserved_bytes -= trace->external_reserved_bytes;
+   trace->external_reserved_bytes = 0;
+   trace->external_range_depth = 0;
+   trace->external_rejected_ranges = 0;
+   pthread_mutex_unlock(&state->mutex);
+}
+
+static uint32_t
+trace_point(const char *name)
+{
+   if (!strcmp(name, "render_pass")) {
+      return NativeAdrenoTraceTurnipRenderPass;
+   }
+   if (!strcmp(name, "binning_ib")) {
+      return NativeAdrenoTraceTurnipBinning;
+   }
+   if (!strcmp(name, "draw_ib_sysmem")) {
+      return NativeAdrenoTraceTurnipDrawSysmem;
+   }
+   if (!strcmp(name, "draw_ib_gmem")) {
+      return NativeAdrenoTraceTurnipDrawGmem;
+   }
+   if (!strcmp(name, "compute")) {
+      return NativeAdrenoTraceTurnipCompute;
+   }
+   if (!strcmp(name, "compute_indirect")) {
+      return NativeAdrenoTraceTurnipComputeIndirect;
+   }
+   if (!strcmp(name, "gmem_load")) {
+      return NativeAdrenoTraceTurnipGmemLoad;
+   }
+   if (!strcmp(name, "gmem_store")) {
+      return NativeAdrenoTraceTurnipGmemStore;
+   }
+   if (!strcmp(name, "cache_flush")) {
+      return NativeAdrenoTraceTurnipCacheFlush;
+   }
+   if (!strcmp(name, "tile_store_ib")) {
+      return NativeAdrenoTraceTurnipTileStore;
+   }
+   return NativeAdrenoTraceTurnipCopy;
+}
+
+static void
+trace_consume(struct u_trace_context *context, uint32_t generation, uint64_t timestamp,
+               const char *name, uint16_t point, uint32_t type, uint32_t flags,
+               const void *flush_data, const void *payload)
+{
+   tu_darwin_trace_state *state = trace_state((tu_device *)context->pctx);
+   const tu_u_trace_submission_data *submit = (const tu_u_trace_submission_data *)flush_data;
+   if (submit->darwin_trace_generation != generation) {
+      return;
+   }
+   NativeAdrenoTraceEvent event = {};
+   const bool begin = type == 0;
+   const char *stage = begin ? name + 6 : type == 1 ? name + 4 : name;
+   event.source = NativeAdrenoTraceSourceTurnip;
+   event.point = trace_point(stage);
+   if ((flags & TU_DARWIN_TRACE_SKIP_GMEM) &&
+       (event.point == NativeAdrenoTraceTurnipGmemLoad ||
+        event.point == NativeAdrenoTraceTurnipGmemStore || !strcmp(stage, "gmem_clear"))) {
+      pthread_mutex_lock(&state->mutex);
+      state->unexecuted_gmem_points++;
+      pthread_mutex_unlock(&state->mutex);
+      return;
+   }
+   event.phase = type + 1;
+   event.clock_domain = NativeAdrenoTraceClockGpuNanoseconds;
+   event.timestamp_ns = timestamp;
+   event.submission_id = (uint64_t)submit->submission_id + 1;
+   event.completion_id = submit->fence;
+   event.process_id = getpid();
+   event.queue_id = submit->queue->msm_queue_id;
+   event.flags = submit->darwin_trace_failed || !timestamp ? NativeAdrenoTraceEventInvalid : 0;
+   snprintf(event.name, sizeof(event.name), "%s", stage);
+   if (begin) {
+      memcpy(&event.command_buffer_id, payload, sizeof(event.command_buffer_id));
+      state->stage_commands[event.point] = event.command_buffer_id;
+   } else {
+      event.command_buffer_id = state->stage_commands[event.point];
+   }
+
+   if (event.point == NativeAdrenoTraceTurnipRenderPass && begin) {
+      const struct trace_start_render_pass *data = (const struct trace_start_render_pass *)payload;
+      trace_argument(&event, NativeAdrenoTraceArgWidth, data->width);
+      trace_argument(&event, NativeAdrenoTraceArgHeight, data->height);
+      trace_argument(&event, NativeAdrenoTraceArgBins, data->numberOfBins);
+      trace_argument(&event, NativeAdrenoTraceArgSamples, data->maxSamples);
+   } else if (event.point == NativeAdrenoTraceTurnipRenderPass) {
+      const struct trace_end_render_pass *data = (const struct trace_end_render_pass *)payload;
+      trace_argument(&event, NativeAdrenoTraceArgDrawCount, data->drawCount);
+      trace_argument(&event, NativeAdrenoTraceArgTiled, data->tiledRender);
+      trace_argument(&event, NativeAdrenoTraceArgBandwidth, data->avgPerSampleBandwidth);
+      trace_argument(&event, NativeAdrenoTraceArgLrz, data->lrz);
+   } else if (event.point == NativeAdrenoTraceTurnipCacheFlush && begin) {
+      const struct trace_start_cache_flush *data = (const struct trace_start_cache_flush *)payload;
+      trace_argument(&event, NativeAdrenoTraceArgFlushBits, data->flush_bits);
+   } else if (event.point == NativeAdrenoTraceTurnipGmemLoad && begin) {
+      const struct trace_start_gmem_load *data = (const struct trace_start_gmem_load *)payload;
+      trace_argument(&event, NativeAdrenoTraceArgFormat, data->format);
+      trace_argument(&event, NativeAdrenoTraceArgForceLoad, data->force_load);
+   } else if (event.point == NativeAdrenoTraceTurnipGmemStore && begin) {
+      const struct trace_start_gmem_store *data = (const struct trace_start_gmem_store *)payload;
+      trace_argument(&event, NativeAdrenoTraceArgFormat, data->format);
+      trace_argument(&event, NativeAdrenoTraceArgFastPath, data->fast_path);
+      trace_argument(&event, NativeAdrenoTraceArgUnaligned, data->unaligned);
+   } else if (event.point == NativeAdrenoTraceTurnipCompute && begin) {
+      const struct trace_start_compute *data = (const struct trace_start_compute *)payload;
+      trace_argument(&event, NativeAdrenoTraceArgLocalSize,
+                     (uint64_t)data->local_size_x | ((uint64_t)data->local_size_y << 16) |
+                     ((uint64_t)data->local_size_z << 32));
+      trace_argument(&event, NativeAdrenoTraceArgGroupCount,
+                     (uint64_t)data->num_groups_x | ((uint64_t)data->num_groups_y << 16) |
+                     ((uint64_t)data->num_groups_z << 32));
+      trace_argument(&event, NativeAdrenoTraceArgIndirect, data->indirect);
+   } else if (begin && !strcmp(stage, "copy_buffer_to_image")) {
+      const struct trace_start_copy_buffer_to_image *data =
+         (const struct trace_start_copy_buffer_to_image *)payload;
+      trace_argument(&event, NativeAdrenoTraceArgDestinationFormat, data->format);
+   } else if (begin && !strcmp(stage, "copy_image_to_buffer")) {
+      const struct trace_start_copy_image_to_buffer *data =
+         (const struct trace_start_copy_image_to_buffer *)payload;
+      trace_argument(&event, NativeAdrenoTraceArgSourceFormat, data->format);
+   } else if (begin && !strcmp(stage, "copy_image")) {
+      const struct trace_start_copy_image *data = (const struct trace_start_copy_image *)payload;
+      trace_argument(&event, NativeAdrenoTraceArgSourceFormat, data->src_format);
+      trace_argument(&event, NativeAdrenoTraceArgDestinationFormat, data->dst_format);
+   } else if (begin && !strcmp(stage, "resolve_image")) {
+      const struct trace_start_resolve_image *data = (const struct trace_start_resolve_image *)payload;
+      trace_argument(&event, NativeAdrenoTraceArgSourceFormat, data->src_format);
+      trace_argument(&event, NativeAdrenoTraceArgDestinationFormat, data->dst_format);
+   } else if (!begin && !strcmp(stage, "copy_buffer")) {
+      const struct trace_end_copy_buffer *data = (const struct trace_end_copy_buffer *)payload;
+      trace_argument(&event, NativeAdrenoTraceArgBytes, data->size);
+      trace_argument(&event, NativeAdrenoTraceArgUnaligned, data->unaligned);
+   }
+
+   pthread_mutex_lock(&state->mutex);
+   while (state->count == TRACE_LOCAL_EVENTS &&
+          generation == state->producer.generation && state->producer.producer_id) {
+      pthread_cond_wait(&state->changed, &state->mutex);
+   }
+   trace_append_locked(state, generation, event);
+   pthread_mutex_unlock(&state->mutex);
+}
+
+static void
+trace_send(tu_darwin_trace_state *state)
+{
+   for (uint32_t sent = 0; ; ++sent) {
+      NativeAdrenoTraceBatch batch = {};
+      pthread_mutex_lock(&state->mutex);
+      if (!state->count || !state->producer.producer_id ||
+          (p_atomic_read(&state->active_generation) && sent == 128)) {
+         pthread_mutex_unlock(&state->mutex);
+         return;
+      }
+      batch.version = NativeAdrenoTraceVersion;
+      batch.generation = state->producer.generation;
+      batch.producer_id = state->producer.producer_id;
+      batch.count = MIN2(state->count, (uint32_t)NativeAdrenoTraceBatchEvents);
+      for (uint32_t i = 0; i < batch.count; ++i) {
+         batch.events[i] = state->events[state->head];
+         state->head = (state->head + 1) % TRACE_LOCAL_EVENTS;
+      }
+      state->count -= batch.count;
+      pthread_cond_broadcast(&state->changed);
+      pthread_mutex_unlock(&state->mutex);
+
+      if (tu_darwin_trace_call(state->device, NativeAdrenoMethodAppendTrace,
+                               &batch, sizeof(batch), NULL, 0)) {
+         pthread_mutex_lock(&state->mutex);
+         state->dropped += batch.count;
+         state->append_dropped += batch.count;
+         pthread_mutex_unlock(&state->mutex);
+      }
+   }
+}
+
+static void
+trace_end(tu_darwin_trace_state *state)
+{
+   trace_send(state);
+   pthread_mutex_lock(&state->mutex);
+   if (!state->end_records_written) {
+      NativeAdrenoTraceEvent cost = trace_cpu_event(state, NativeAdrenoTraceTurnipInstrumentation,
+                                                   "trace_command_dwords");
+      trace_argument(&cost, NativeAdrenoTraceArgTimestampDwords, state->timestamp_dwords);
+      trace_argument(&cost, NativeAdrenoTraceArgCopyDwords, state->copy_dwords);
+      trace_argument(&cost, NativeAdrenoTraceArgWaitForMeDwords, state->wait_dwords);
+      trace_argument(&cost, NativeAdrenoTraceArgExtraWaitForIdleDwords, 0);
+      trace_append_locked(state, state->producer.generation, cost);
+
+      NativeAdrenoTraceEvent loss = trace_cpu_event(state, NativeAdrenoTraceTurnipRecordCounts,
+                                                   "trace_record_losses");
+      trace_argument(&loss, NativeAdrenoTraceArgBudgetDropped, state->budget_dropped);
+      trace_argument(&loss, NativeAdrenoTraceArgQueueDropped, state->queue_dropped);
+      trace_argument(&loss, NativeAdrenoTraceArgAppendDropped, state->append_dropped);
+      trace_append_locked(state, state->producer.generation, loss);
+
+      NativeAdrenoTraceEvent excluded = trace_cpu_event(state, NativeAdrenoTraceTurnipRecordCounts,
+                                                       "trace_excluded_records");
+      trace_argument(&excluded, NativeAdrenoTraceArgUnsubmittedCommands, state->unsubmitted_commands);
+      trace_argument(&excluded, NativeAdrenoTraceArgUnexecutedGmemPoints, state->unexecuted_gmem_points);
+      trace_argument(&excluded, NativeAdrenoTraceArgReservedBytesHighWater, state->reserved_bytes_peak);
+      trace_argument(&excluded, NativeAdrenoTraceArgBudgetBytes, TRACE_MEMORY_BYTES);
+      trace_append_locked(state, state->producer.generation, excluded);
+      state->end_records_written = true;
+   }
+   pthread_mutex_unlock(&state->mutex);
+   trace_send(state);
+
+   pthread_mutex_lock(&state->mutex);
+   NativeAdrenoTraceProducer producer = state->producer;
+   producer.dropped = state->dropped;
+   pthread_mutex_unlock(&state->mutex);
+   if (!tu_darwin_trace_call(state->device, NativeAdrenoMethodEndTraceProducer,
+                             &producer, sizeof(producer), NULL, 0)) {
+      pthread_mutex_lock(&state->mutex);
+      state->producer = {};
+      pthread_cond_broadcast(&state->changed);
+      pthread_mutex_unlock(&state->mutex);
+   }
+}
+
+static void *
+trace_worker(void *opaque)
+{
+   tu_darwin_trace_state *state = (tu_darwin_trace_state *)opaque;
+   for (;;) {
+      pthread_mutex_lock(&state->device->submit_mutex);
+      NativeAdrenoTraceStatus status = {};
+      const bool query_ok = !tu_darwin_trace_call(state->device, NativeAdrenoMethodQueryTrace,
+                                                  NULL, 0, &status, sizeof(status));
+      const bool running = query_ok && status.state == NativeAdrenoTraceRunning &&
+                           !p_atomic_read(&state->stop);
+      if (running && !state->producer.producer_id) {
+         NativeAdrenoTraceProducer producer = {};
+         producer.version = NativeAdrenoTraceVersion;
+         producer.generation = status.generation;
+         producer.source = NativeAdrenoTraceSourceTurnip;
+         if (!tu_darwin_trace_call(state->device, NativeAdrenoMethodRegisterTraceProducer,
+                                   &producer, sizeof(producer), &producer, sizeof(producer))) {
+            pthread_mutex_lock(&state->mutex);
+            state->producer = producer;
+            state->dropped = 0;
+            state->budget_dropped = 0;
+            state->queue_dropped = 0;
+            state->append_dropped = 0;
+            state->unsubmitted_commands = 0;
+            state->unexecuted_gmem_points = 0;
+            state->reserved_bytes_peak = state->reserved_bytes;
+            state->timestamp_dwords = 0;
+            state->copy_dwords = 0;
+            state->wait_dwords = 0;
+            state->end_records_written = false;
+            p_atomic_set(&state->active_generation, producer.generation);
+            pthread_mutex_unlock(&state->mutex);
+         }
+      }
+      if (p_atomic_read(&state->stop) || (query_ok && !running)) {
+         pthread_mutex_lock(&state->mutex);
+         p_atomic_set(&state->active_generation, 0);
+         state->unsubmitted_commands += state->pending_commands;
+         state->pending_commands = 0;
+         pthread_mutex_unlock(&state->mutex);
+      }
+      pthread_mutex_unlock(&state->device->submit_mutex);
+      trace_send(state);
+
+      pthread_mutex_lock(&state->mutex);
+      const bool draining = state->producer.producer_id && !p_atomic_read(&state->active_generation);
+      const bool pending = state->pending_submissions;
+      pthread_mutex_unlock(&state->mutex);
+      if (draining && !pending) {
+         trace_end(state);
+      }
+      if (p_atomic_read(&state->stop) && !state->producer.producer_id) {
+         return NULL;
+      }
+      struct timespec deadline;
+      clock_gettime(CLOCK_REALTIME, &deadline);
+      deadline.tv_nsec += 10000000;
+      if (deadline.tv_nsec >= 1000000000) {
+         deadline.tv_sec++;
+         deadline.tv_nsec -= 1000000000;
+      }
+      pthread_mutex_lock(&state->mutex);
+      if (!state->count) {
+         pthread_cond_timedwait(&state->changed, &state->mutex, &deadline);
+      }
+      pthread_mutex_unlock(&state->mutex);
+   }
+}
+
+void
+tu_darwin_trace_init(struct tu_device *device)
+{
+   if (!device->darwin_retire || device->physical_device->info->chip != A6XX) {
+      return;
+   }
+   tu_darwin_trace_state *state = (tu_darwin_trace_state *)calloc(1, sizeof(*state));
+   if (!state) {
+      return;
+   }
+   state->device = device;
+   mach_timebase_info(&state->timebase);
+   if (pthread_mutex_init(&state->mutex, NULL)) {
+      free(state);
+      return;
+   }
+   if (pthread_cond_init(&state->changed, NULL)) {
+      pthread_mutex_destroy(&state->mutex);
+      free(state);
+      return;
+   }
+   device->darwin_trace = state;
+   device->trace_context.accept_external_event = trace_accept;
+   device->trace_context.release_external_allocations = trace_release_allocations;
+   device->trace_context.consume_external_event = trace_consume;
+   device->trace_context.enabled_traces = (u_trace_type)(device->trace_context.enabled_traces |
+                                                        U_TRACE_TYPE_EXTERNAL);
+   tu_gpu_tracepoint = TU_GPU_TRACEPOINT_RENDER_PASS | TU_GPU_TRACEPOINT_BINNING_IB |
+                      TU_GPU_TRACEPOINT_DRAW_IB_SYSMEM | TU_GPU_TRACEPOINT_DRAW_IB_GMEM |
+                      TU_GPU_TRACEPOINT_COMPUTE | TU_GPU_TRACEPOINT_COMPUTE_INDIRECT |
+                      TU_GPU_TRACEPOINT_CLEAR_BLIT | TU_GPU_TRACEPOINT_GMEM_LOAD |
+                      TU_GPU_TRACEPOINT_GMEM_STORE | TU_GPU_TRACEPOINT_CACHE_FLUSH |
+                      TU_GPU_TRACEPOINT_TILE_STORE_IB;
+   if (pthread_create(&state->worker, NULL, trace_worker, state)) {
+      device->darwin_trace = NULL;
+      device->trace_context.accept_external_event = NULL;
+      device->trace_context.release_external_allocations = NULL;
+      device->trace_context.consume_external_event = NULL;
+      device->trace_context.enabled_traces = (u_trace_type)(device->trace_context.enabled_traces &
+                                                           ~U_TRACE_TYPE_EXTERNAL);
+      pthread_mutex_destroy(&state->mutex);
+      pthread_cond_destroy(&state->changed);
+      free(state);
+   }
+}
+
+void
+tu_darwin_trace_finish(struct tu_device *device)
+{
+   tu_darwin_trace_state *state = trace_state(device);
+   if (!state) {
+      return;
+   }
+   p_atomic_set(&state->stop, true);
+   pthread_mutex_lock(&state->mutex);
+   pthread_cond_broadcast(&state->changed);
+   pthread_mutex_unlock(&state->mutex);
+   pthread_join(state->worker, NULL);
+   util_queue_finish(&device->trace_context.queue);
+   device->trace_context.accept_external_event = NULL;
+   device->trace_context.release_external_allocations = NULL;
+   device->trace_context.consume_external_event = NULL;
+   device->darwin_trace = NULL;
+   pthread_mutex_destroy(&state->mutex);
+   pthread_cond_destroy(&state->changed);
+   free(state);
+}
+
+void
+tu_darwin_trace_begin(struct tu_cmd_buffer *cmd)
+{
+   tu_darwin_trace_state *state = trace_state(cmd->device);
+   if (!state) {
+      return;
+   }
+   tu_darwin_trace_release(cmd);
+   pthread_mutex_lock(&state->mutex);
+   cmd->darwin_trace_id = p_atomic_inc_return(&trace_next_command);
+   cmd->darwin_trace_generation = p_atomic_read(&state->active_generation);
+   if (cmd->darwin_trace_generation &&
+       cmd->vk.level == VK_COMMAND_BUFFER_LEVEL_PRIMARY &&
+       (cmd->usage_flags & VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT)) {
+      state->pending_commands++;
+      cmd->darwin_trace_pending = true;
+      cmd->trace.external_generation = cmd->darwin_trace_generation;
+      cmd->rp_trace.external_generation = cmd->darwin_trace_generation;
+   }
+   pthread_mutex_unlock(&state->mutex);
+}
+
+void
+tu_darwin_trace_release(struct tu_cmd_buffer *cmd)
+{
+   tu_darwin_trace_state *state = trace_state(cmd->device);
+   if (state && cmd->darwin_trace_pending) {
+      pthread_mutex_lock(&state->mutex);
+      if (cmd->darwin_trace_generation == state->producer.generation && state->pending_commands) {
+         state->pending_commands--;
+      }
+      pthread_mutex_unlock(&state->mutex);
+   }
+   cmd->darwin_trace_pending = false;
+   cmd->darwin_trace_generation = 0;
+   cmd->trace.external_generation = 0;
+   cmd->rp_trace.external_generation = 0;
+}
+
+void
+tu_darwin_trace_execute(struct tu_cmd_buffer *cmd, struct tu_cmd_buffer *secondary)
+{
+   tu_darwin_trace_state *state = trace_state(cmd->device);
+   if (!state || !cmd->darwin_trace_generation) {
+      return;
+   }
+   NativeAdrenoTraceEvent event = trace_cpu_event(state, NativeAdrenoTraceTurnipExecute,
+                                                 "execute_secondary");
+   event.command_buffer_id = cmd->darwin_trace_id;
+   trace_argument(&event, NativeAdrenoTraceArgSecondaryCommand, secondary->darwin_trace_id);
+   trace_append(state, cmd->darwin_trace_generation, event);
+}
+
+void
+tu_darwin_trace_submit(struct tu_queue *queue, struct tu_cmd_buffer **commands,
+                       uint32_t count, struct tu_u_trace_submission_data *data)
+{
+   tu_darwin_trace_state *state = trace_state(queue->device);
+   if (!state) {
+      return;
+   }
+
+   for (uint32_t i = 0; i < count; ++i) {
+      tu_cmd_buffer *cmd = commands[i];
+      if (!(cmd->usage_flags & VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT) ||
+          !u_trace_has_points(&cmd->trace)) {
+         continue;
+      }
+      if (cmd->rp_trace.external_reserved_bytes) {
+         u_trace_transfer_buffer_ownership(&cmd->trace, &cmd->rp_trace);
+      }
+      if (cmd->pre_chain.rp_trace.external_reserved_bytes) {
+         u_trace_transfer_buffer_ownership(&cmd->trace, &cmd->pre_chain.rp_trace);
+      }
+   }
+   if (!p_atomic_read(&state->active_generation)) {
+      return;
+   }
+
+   /* The caller holds submit_mutex through submission and producer admission. */
+   const uint64_t accepted_ns = trace_now(state);
+   NativeAdrenoTraceStatus status = {};
+   const bool query_ok = !tu_darwin_trace_call(state->device, NativeAdrenoMethodQueryTrace,
+                                               NULL, 0, &status, sizeof(status));
+   pthread_mutex_lock(&state->mutex);
+   const bool stopped = query_ok && status.generation == state->producer.generation &&
+                        status.stopped_ns;
+   if (stopped && accepted_ns > status.stopped_ns) {
+      p_atomic_set(&state->active_generation, 0);
+      state->unsubmitted_commands += state->pending_commands;
+      state->pending_commands = 0;
+      pthread_cond_broadcast(&state->changed);
+      pthread_mutex_unlock(&state->mutex);
+      return;
+   }
+   for (uint32_t i = 0; i < count; ++i) {
+      tu_cmd_buffer *cmd = commands[i];
+      if (cmd->darwin_trace_generation != state->producer.generation ||
+          cmd->darwin_trace_generation != p_atomic_read(&state->active_generation) ||
+          !state->producer.producer_id) {
+         continue;
+      }
+      NativeAdrenoTraceEvent event = trace_cpu_event(state, NativeAdrenoTraceTurnipSubmit,
+                                                    "submit_command_buffer");
+      event.command_buffer_id = cmd->darwin_trace_id;
+      event.submission_id = (uint64_t)queue->device->submit_count + 1;
+      event.completion_id = queue->fence;
+      event.queue_id = queue->msm_queue_id;
+      trace_append_locked(state, cmd->darwin_trace_generation, event);
+      if (data && u_trace_has_points(&cmd->trace) && !data->darwin_trace_generation) {
+         data->darwin_trace_generation = cmd->darwin_trace_generation;
+         state->pending_submissions++;
+      }
+      if (cmd->darwin_trace_pending) {
+         cmd->darwin_trace_pending = false;
+         if (state->pending_commands) {
+            state->pending_commands--;
+         }
+      }
+   }
+   if (stopped) {
+      p_atomic_set(&state->active_generation, 0);
+      state->unsubmitted_commands += state->pending_commands;
+      state->pending_commands = 0;
+      pthread_cond_broadcast(&state->changed);
+   }
+   pthread_mutex_unlock(&state->mutex);
+}
+
+void
+tu_darwin_trace_retire(struct tu_device *device, struct tu_u_trace_submission_data *data)
+{
+   tu_darwin_trace_state *state = trace_state(device);
+   if (!state || !data->darwin_trace_generation) {
+      return;
+   }
+   pthread_mutex_lock(&state->mutex);
+   if (data->darwin_trace_generation == state->producer.generation && state->pending_submissions) {
+      state->pending_submissions--;
+      pthread_cond_broadcast(&state->changed);
+   }
+   pthread_mutex_unlock(&state->mutex);
+}
+
+void
+tu_darwin_trace_command_cost(struct tu_device *device, uint32_t generation,
+                             uint32_t timestamp_dwords, uint32_t copy_dwords,
+                             uint32_t wait_dwords)
+{
+   tu_darwin_trace_state *state = trace_state(device);
+   if (!state || (!generation && !copy_dwords)) {
+      return;
+   }
+   pthread_mutex_lock(&state->mutex);
+   if (state->producer.producer_id && (!generation || generation == state->producer.generation)) {
+      state->timestamp_dwords += timestamp_dwords;
+      state->copy_dwords += copy_dwords;
+      state->wait_dwords += wait_dwords;
+   }
+   pthread_mutex_unlock(&state->mutex);
+}
+
+VkBool32 VKAPI_CALL
+tu_NativeAdrenoTraceEnabled(VkDevice handle)
+{
+   VK_FROM_HANDLE(tu_device, device, handle);
+   tu_darwin_trace_state *state = trace_state(device);
+   return state ? p_atomic_read(&state->active_generation) : 0;
+}
+
+void VKAPI_CALL
+tu_NativeAdrenoTraceMetal(VkDevice handle, VkCommandBuffer command,
+                          uint32_t type, uint32_t flags,
+                          const uint64_t *words, uint32_t count)
+{
+   VK_FROM_HANDLE(tu_device, device, handle);
+   tu_darwin_trace_state *state = trace_state(device);
+   if (!state || !words || type < 1 || type > 7 || count > 4) {
+      return;
+   }
+   const uint32_t generation = p_atomic_read(&state->active_generation);
+   if (!generation) {
+      return;
+   }
+   static const char *names[] = {"", "metal_encoder", "metal_render_pass", "metal_attachment",
+                                "metal_texture", "metal_pipeline", "metal_draw", "metal_encoder_end"};
+   NativeAdrenoTraceEvent event = trace_cpu_event(state, type, names[type]);
+   event.source = NativeAdrenoTraceSourceMetal;
+   event.flags = flags << 16;
+   if (command) {
+      VK_FROM_HANDLE(tu_cmd_buffer, cmd, command);
+      event.command_buffer_id = cmd->darwin_trace_id;
+   }
+   for (uint32_t i = 0; i < count; ++i) {
+      trace_argument(&event, type * 16 + i, words[i]);
+   }
+   trace_append(state, generation, event);
+}
+
+#endif
