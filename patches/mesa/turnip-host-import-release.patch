diff --git a/src/freedreno/vulkan/tu_knl_darwin.cc b/src/freedreno/vulkan/tu_knl_darwin.cc
index 9a6252e..214e4c8 100644
--- a/src/freedreno/vulkan/tu_knl_darwin.cc
+++ b/src/freedreno/vulkan/tu_knl_darwin.cc
@@ -464,6 +464,7 @@ darwin_bo_init_host(struct tu_device *dev, struct tu_bo **out_bo, void *pointer,
    bo->darwin_token = 0;
    bo->map = pointer;
    bo->never_unmap = true;
+   bo->darwin_host_import = true;
    tu_dump_bo_init(dev, bo);
    TU_RMV(bo_allocate, dev, bo);
    *out_bo = bo;
@@ -573,6 +574,31 @@ darwin_wait_idle(struct tu_device *dev)
    return VK_SUCCESS;
 }
 
+VkResult
+tu_darwin_release_host_bo(struct tu_device *dev, struct tu_bo *bo)
+{
+   if (!bo->darwin_host_import)
+      return vk_error(dev, VK_ERROR_INVALID_EXTERNAL_HANDLE);
+   if (bo->darwin_host_detached)
+      return VK_SUCCESS;
+
+   /* The caller has ended every use of this VkDeviceMemory. The captured
+    * fence covers those submissions; later unrelated work does not extend it. */
+   VkResult waited = darwin_wait_idle(dev);
+   if (waited != VK_SUCCESS)
+      return vk_device_set_lost(&dev->vk, "host import release fence failed: %d", waited);
+
+   NativeAdrenoAbiBoFree request = {.handle = bo->darwin_handle};
+   kern_return_t kr = dw_call(NativeAdrenoMethodBoFree, &request, sizeof(request), NULL, 0);
+   if (kr != KERN_SUCCESS)
+      return vk_device_set_lost(&dev->vk, "host import release BoFree failed: 0x%x", kr);
+
+   /* Successful BoFree removes the SMMU mapping and cache-maintenance entry
+    * before completing and releasing the descriptor that pins the owner. */
+   bo->darwin_host_detached = true;
+   return VK_SUCCESS;
+}
+
 static void
 darwin_bo_finish(struct tu_device *dev, struct tu_bo *bo)
 {
@@ -585,6 +611,24 @@ darwin_bo_finish(struct tu_device *dev, struct tu_bo *bo)
       return;
    }
 
+   if (bo->darwin_host_import) {
+      VkResult released = tu_darwin_release_host_bo(dev, bo);
+      if (released != VK_SUCCESS) {
+         /* The native owner handshake retains its deallocator on this error.
+          * Preserve the BO record and IOVA with the kernel's pinned pages. */
+         u_rwlock_rdunlock(&dev->dma_bo_lock);
+         return;
+      }
+
+      tu_debug_bos_del(dev, bo);
+      tu_dump_bo_del(dev, bo);
+      TU_RMV(bo_destroy, dev, bo);
+      darwin_free_iova(dev, bo->iova, bo->size);
+      memset(bo, 0, sizeof(*bo));
+      u_rwlock_rdunlock(&dev->dma_bo_lock);
+      return;
+   }
+
    tu_debug_bos_del(dev, bo);
    tu_dump_bo_del(dev, bo);
 
