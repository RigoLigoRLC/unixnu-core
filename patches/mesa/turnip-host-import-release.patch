diff --git a/src/freedreno/vulkan/tu_device.cc b/src/freedreno/vulkan/tu_device.cc
index 527a4d4..fec54fa 100644
--- a/src/freedreno/vulkan/tu_device.cc
+++ b/src/freedreno/vulkan/tu_device.cc
@@ -3499,12 +3499,32 @@ vk_icdGetInstanceProcAddr(VkInstance instance, const char *pName)
 }
 
 #ifdef __APPLE__
+/* The native Metal owner needs an error-bearing acknowledgement before its
+ * deallocator can release imported pages. vkFreeMemory itself returns void. */
+static VKAPI_ATTR VkResult VKAPI_CALL
+tu_ReleaseHostMemoryUNIXNU(VkDevice _device, VkDeviceMemory _memory)
+{
+#ifdef TU_HAS_DARWIN
+   VK_FROM_HANDLE(tu_device, device, _device);
+   VK_FROM_HANDLE(tu_device_memory, memory, _memory);
+   if (!memory || !memory->bo || !memory->bo->darwin_host_import)
+      return VK_ERROR_INVALID_EXTERNAL_HANDLE;
+
+   return tu_darwin_release_host_bo(device, memory->bo);
+#else
+   return VK_ERROR_FEATURE_NOT_PRESENT;
+#endif
+}
+
 /* iPadOS has no Khronos loader: a consumer that opens a loader by path (the metal2vulkan runtime behind the native Metal device) opens this
  * library and looks up the loader's name. Turnip is the only driver there, so the loader's entry is the driver's own. */
 PUBLIC
 VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL
 vkGetInstanceProcAddr(VkInstance instance, const char *pName)
 {
+   if (pName && !strcmp(pName, "vkReleaseHostMemoryUNIXNU"))
+      return (PFN_vkVoidFunction)tu_ReleaseHostMemoryUNIXNU;
+
    return tu_GetInstanceProcAddr(instance, pName);
 }
 #endif
