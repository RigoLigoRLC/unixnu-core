diff --git a/src/freedreno/vulkan/tu_cmd_buffer.cc b/src/freedreno/vulkan/tu_cmd_buffer.cc
index 197c99b..1b43712 100644
--- a/src/freedreno/vulkan/tu_cmd_buffer.cc
+++ b/src/freedreno/vulkan/tu_cmd_buffer.cc
@@ -1561,10 +1561,9 @@ use_sysmem_rendering(struct tu_cmd_buffer *cmd,
                      tu_autotune::rp_key_opt rp_key)
 {
    const uint32_t capture_mode = tu_darwin_trace_render_mode(cmd);
-   if (TU_DEBUG(SYSMEM) || capture_mode == 2) {
-      cmd->state.rp.gmem_disable_reason = capture_mode == 2 ? "Capture selected sysmem" : "TU_DEBUG(SYSMEM)";
-      return true;
-   }
+   /* TU_DEBUG(SYSMEM) permits unbacked transient attachments to stay in GMEM.
+    * An explicit capture selection still uses system memory for comparison. */
+   const bool forced_sysmem = TU_DEBUG(SYSMEM) || capture_mode == 2;
 
    /* can't fit attachments into gmem */
    if (!cmd->state.tiling->possible) {
@@ -1617,7 +1616,7 @@ use_sysmem_rendering(struct tu_cmd_buffer *cmd,
       return true;
    }
 
-   if (TU_DEBUG(GMEM) || capture_mode == 1) {
+   if ((TU_DEBUG(GMEM) || capture_mode == 1) && !forced_sysmem) {
       cmd->state.rp.gmem_disable_reason = capture_mode == 1 ? "Capture selected gmem" : "TU_DEBUG(GMEM)";
       return false;
    }
@@ -1630,7 +1629,7 @@ use_sysmem_rendering(struct tu_cmd_buffer *cmd,
 
    /* An unbacked memoryless attachment stays in GMEM when this pass can use
     * tile memory. Choosing SYSMEM here would allocate its full backing BO. */
-   for (unsigned i = 0; i < cmd->state.pass->attachment_count; ++i) {
+   for (unsigned i = 0; capture_mode != 2 && i < cmd->state.pass->attachment_count; ++i) {
       const struct tu_image_view *iview = cmd->state.attachments[i];
       if (iview && !(iview->image->vk.create_flags & VK_IMAGE_CREATE_SPARSE_BINDING_BIT) &&
           iview->image->mem && iview->image->mem->lazy && !iview->image->mem->bo) {
@@ -1638,6 +1637,11 @@ use_sysmem_rendering(struct tu_cmd_buffer *cmd,
       }
    }
 
+   if (forced_sysmem) {
+      cmd->state.rp.gmem_disable_reason = capture_mode == 2 ? "Capture selected sysmem" : "TU_DEBUG(SYSMEM)";
+      return true;
+   }
+
    tu_autotune::render_mode optimal_mode =
       cmd->device->autotune->get_optimal_mode(cmd, rp_ctx, rp_key);
    bool use_sysmem = optimal_mode == tu_autotune::render_mode::SYSMEM;
