    return mutable_view ? info : ((info & ~swap_mask) | identity);
 }
 
+/* The memory side keeps the image view's swap. A linear BGRA image uses
+ * WXYZ to convert between shader component order in GMEM and BGRA bytes
+ * in ordinary device memory or imported host memory. */
+static inline uint32_t
+tu_gmem_memory_side_info(uint32_t info)
+{
+   return info;
+}
