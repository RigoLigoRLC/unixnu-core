+/* vk_darwin_async_sync owns one kernel timeline or binary payload. Accepted
+ * jobs retain that payload, so reset and move can replace its userspace lease
+ * while earlier queued work still refers to the original object. */
+struct vk_darwin_async_sync {
+   struct vk_sync vk;
+   uint64_t handle;
+};
+
+static VkResult
+darwin_async_create(struct tu_device *device, bool timeline, uint64_t initial,
+                    uint64_t *handle)
+{
+   const NativeAdrenoAbiSyncCreate request = {initial,
+      timeline ? NativeAdrenoAsyncTimeline : 0u, 0};
+   NativeAdrenoAbiSyncHandle reply = {};
+   const kern_return_t status = dw_call(device, NativeAdrenoMethodSyncCreate,
+      &request, sizeof(request), &reply, sizeof(reply));
+   if (status == kIOReturnNoMemory || status == kIOReturnNoResources) {
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+   }
+   if (status != KERN_SUCCESS) {
+      return dw_status_to_vk(device, status, "create kernel sync");
+   }
+   *handle = reply.handle;
+   return VK_SUCCESS;
+}
+
+static void
+darwin_async_release(struct tu_device *device, uint64_t handle)
+{
+   if (handle) {
+      const NativeAdrenoAbiSyncHandle request = {handle};
+      dw_call(device, NativeAdrenoMethodSyncRelease, &request, sizeof(request), NULL, 0);
+   }
+}
+
+static VkResult
+vk_darwin_async_init(struct vk_device *base, struct vk_sync *sync, uint64_t initial)
+{
+   struct tu_device *device = container_of(base, struct tu_device, vk);
+   struct vk_darwin_async_sync *payload = container_of(sync, struct vk_darwin_async_sync, vk);
+   payload->handle = 0;
+   return darwin_async_create(device, sync->flags & VK_SYNC_IS_TIMELINE, initial, &payload->handle);
+}
+
+static void
+vk_darwin_async_finish(struct vk_device *base, struct vk_sync *sync)
+{
+   struct tu_device *device = container_of(base, struct tu_device, vk);
+   struct vk_darwin_async_sync *payload = container_of(sync, struct vk_darwin_async_sync, vk);
+   darwin_async_release(device, payload->handle);
+   payload->handle = 0;
+}
+
+static VkResult
+vk_darwin_async_reset(struct vk_device *base, struct vk_sync *sync)
+{
+   struct tu_device *device = container_of(base, struct tu_device, vk);
+   struct vk_darwin_async_sync *payload = container_of(sync, struct vk_darwin_async_sync, vk);
+   uint64_t replacement = 0;
+   const VkResult result = darwin_async_create(device, false, 0, &replacement);
+   if (result != VK_SUCCESS) {
+      return result;
+   }
+   darwin_async_release(device, payload->handle);
+   payload->handle = replacement;
+   return VK_SUCCESS;
+}
+
+static VkResult
+vk_darwin_async_move(struct vk_device *base, struct vk_sync *dst, struct vk_sync *src)
+{
+   struct tu_device *device = container_of(base, struct tu_device, vk);
+   struct vk_darwin_async_sync *target = container_of(dst, struct vk_darwin_async_sync, vk);
+   struct vk_darwin_async_sync *source = container_of(src, struct vk_darwin_async_sync, vk);
+   uint64_t replacement = 0;
+   const VkResult result = darwin_async_create(device, false, 0, &replacement);
+   if (result != VK_SUCCESS) {
+      return result;
+   }
+   darwin_async_release(device, target->handle);
+   target->handle = source->handle;
+   source->handle = replacement;
+   return VK_SUCCESS;
+}
+
+static VkResult
+vk_darwin_async_signal(struct vk_device *base, struct vk_sync *sync, uint64_t value)
+{
+   struct tu_device *device = container_of(base, struct tu_device, vk);
+   struct vk_darwin_async_sync *payload = container_of(sync, struct vk_darwin_async_sync, vk);
+   const NativeAdrenoAbiSyncPoint request = {payload->handle,
+      sync->flags & VK_SYNC_IS_TIMELINE ? value : 1};
+   return dw_status_to_vk(device, dw_call(device, NativeAdrenoMethodSyncSignal,
+      &request, sizeof(request), NULL, 0), "signal kernel sync");
+}
+
+static VkResult
+vk_darwin_async_value(struct vk_device *base, struct vk_sync *sync, uint64_t *value)
+{
+   struct tu_device *device = container_of(base, struct tu_device, vk);
+   struct vk_darwin_async_sync *payload = container_of(sync, struct vk_darwin_async_sync, vk);
+   const NativeAdrenoAbiSyncHandle request = {payload->handle};
+   NativeAdrenoAbiSyncValue reply = {};
+   const VkResult result = dw_status_to_vk(device, dw_call(device, NativeAdrenoMethodSyncQuery,
+      &request, sizeof(request), &reply, sizeof(reply)), "query kernel timeline");
+   if (result == VK_SUCCESS) {
+      *value = reply.value;
+   }
+   return result;
+}
+
+static VkResult
+vk_darwin_async_wait_many(struct vk_device *base, uint32_t count,
+                         const struct vk_sync_wait *waits,
+                         enum vk_sync_wait_flags flags, uint64_t absolute)
+{
+   struct tu_device *device = container_of(base, struct tu_device, vk);
+   if (count > NativeAdrenoAsyncMaxWaits) {
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+   }
+   NativeAdrenoAbiSyncWait request = {};
+   request.version = NativeAdrenoAsyncVersion;
+   request.count = count;
+   request.epoch = darwin_connection_for(device)->async_caps.epoch;
+   request.timeout_ns = darwin_relative_timeout(absolute);
+   if (flags & VK_SYNC_WAIT_ANY) {
+      request.flags |= NativeAdrenoAsyncWaitAny;
+   }
+   if (flags & VK_SYNC_WAIT_PENDING) {
+      request.flags |= NativeAdrenoAsyncWaitPending;
+   }
+   for (uint32_t at = 0; at < count; ++at) {
+      const struct vk_darwin_async_sync *payload =
+         container_of(waits[at].sync, struct vk_darwin_async_sync, vk);
+      request.points[at] = {payload->handle,
+         waits[at].sync->flags & VK_SYNC_IS_TIMELINE ? waits[at].wait_value : 1};
+   }
+   return dw_status_to_vk(device, dw_call(device, NativeAdrenoMethodSyncWait,
+      &request, sizeof(request), NULL, 0), "wait kernel sync");
+}
+
+static VkResult
+vk_darwin_async_wait(struct vk_device *device, struct vk_sync *sync, uint64_t value,
+                    enum vk_sync_wait_flags flags, uint64_t absolute)
+{
+   const struct vk_sync_wait wait = {.sync = sync, .wait_value = value};
+   return vk_darwin_async_wait_many(device, 1, &wait, flags, absolute);
+}
