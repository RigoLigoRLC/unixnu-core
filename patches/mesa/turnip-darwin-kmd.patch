diff --git a/src/freedreno/vulkan/tu_knl_darwin.cc b/src/freedreno/vulkan/tu_knl_darwin.cc
new file mode 100644
index 0000000..61b7968
--- /dev/null
+++ b/src/freedreno/vulkan/tu_knl_darwin.cc
@@ -0,0 +1,1805 @@
+/*
+ * Native Darwin kernel backend for Turnip: talks to the NativeAdreno IOKit user client (NativeAdrenoABI.h, version 1).
+ * Modelled on tu_knl_kgsl.cc (no libdrm) and tu_knl_drm_msm.cc (the client chooses GPU addresses).
+ * SPDX-License-Identifier: MIT
+ */
+
+#include <errno.h>
+#include <pthread.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+#include <IOKit/IOKitLib.h>
+#include <mach/mach.h>
+
+#include "NativeAdrenoABI.h"
+
+#include "util/os_time.h"
+#include "util/timespec.h"
+#include "util/u_debug.h"
+#include "util/u_idalloc.h"
+#include "util/u_vector.h"
+#include "vk_util.h"
+
+#include "tu_cmd_buffer.h"
+#include "tu_cs.h"
+#include "tu_device.h"
+#include "tu_dynamic_rendering.h"
+#include "tu_knl.h"
+#include "tu_queue.h"
+#include "tu_rmv.h"
+
+/* 'NTNL': first word of a tunnelled call, as served by the driver (NativeAdrenoPublish.cpp). */
+#define DW_TUNNEL_MAGIC 0x4e544e4cu
+
+/* One GPU per process: the kernel service has a single connection slot, so the connection and the fence bookkeeping are
+ * process state rather than per tu_device state. */
+static struct {
+   io_connect_t conn;
+   bool open;
+   pthread_mutex_t lock;
+   /* Fences of the submissions still possibly in flight, oldest first (the kernel keeps at most eight jobs). */
+   uint32_t inflight[8];
+   unsigned inflight_count;
+   /* Transport. On the tablet a sandboxed process (the Metal plugin inside SpringBoard) reaches the driver through the AGX accelerator
+    * service with open type 0x4147, and the sandbox profile decides which external-method selector numbers are admitted, so every ABI
+    * method travels as {magic, method, payload} through one admitted selector (the same tunnel the plugin's own test uses). Direct
+    * selectors (selector = ABI method) stay available for an unrestricted process that opens NativeAdrenoGpuPublished. */
+   bool tunnel;
+   uint32_t selector;
+   uint32_t last_fence;
+   uint64_t next_profile_device;
+   NativeAdrenoAbiDeviceInfo info;
+   NativeAdrenoAbiParams params;
+} dw = { .lock = PTHREAD_MUTEX_INITIALIZER };
+
+enum {
+   DARWIN_RETIRED_BOS = 256,
+   DARWIN_CACHED_BOS = 64,
+   DARWIN_BO_CACHE_BYTES = 128 * 1024 * 1024,
+   DARWIN_BO_CACHE_MAX_OBJECT_BYTES = 64 * 1024 * 1024,
+};
+
+/* darwin_retired_bo owns the native allocation, CPU mapping and GPU address
+ * after the caller releases its tu_bo. The captured fence must complete before
+ * the allocation can enter the reuse cache or be returned to the kernel. */
+struct darwin_retired_bo {
+   uint64_t handle, iova, size;
+   void *mapping;
+   uint32_t token, fence;
+   uint32_t gem_handle, alloc_flags;
+   VkMemoryPropertyFlags mem_property;
+   uint64_t alignment;
+   bool cacheable;
+   char name[32];
+};
+
+/* darwin_retire_state retains unfinished BOs and completed private BOs. Its
+ * mutex protects both bounded arrays and the independent Mesa ID allocator.
+ * Fence waits that may block run after releasing this mutex. */
+struct darwin_retire_state {
+   pthread_mutex_t lock;
+   struct util_idalloc ids;
+   struct darwin_retired_bo entries[DARWIN_RETIRED_BOS];
+   /* Cache entries are ordered from the oldest completed BO to the newest. */
+   struct darwin_retired_bo cache[DARWIN_CACHED_BOS];
+   unsigned head, count;
+   unsigned cache_count;
+   VkResult failure;
+   uint64_t enqueued, reaped, pressure_waits;
+   uint64_t cache_bytes, cache_peak_bytes, cache_hits, cache_misses, cache_evictions;
+   uint64_t pending_bytes;
+   NativeAdrenoAbiBoCacheCounters profile;
+   NativeAdrenoAbiBoCacheBin sizes[NativeAdrenoBoProfileSizeCount];
+   NativeAdrenoAbiBoCacheBin usages[NativeAdrenoBoProfileUsageCount];
+   NativeAdrenoAbiBoProfile slow[NativeAdrenoBoProfileSlowCount];
+   pthread_t reporter;
+   pthread_cond_t report_wake;
+   bool reporter_started, reporter_stop;
+   uint64_t profile_device;
+   io_connect_t profile_connection;
+   bool profile_tunnel;
+   uint32_t profile_selector;
+};
+
+static kern_return_t
+dw_call(uint32_t method, const void *in, size_t in_size, void *out,
+        size_t out_size)
+{
+   size_t out_bytes = out_size;
+   if (!dw.tunnel)
+      return IOConnectCallStructMethod(dw.conn, method, in, in_size, out_size ? out : NULL,
+                                       out_size ? &out_bytes : NULL);
+   uint8_t buffer[8 + sizeof(NativeAdrenoAbiSubmit)];
+   if (in_size > sizeof(NativeAdrenoAbiSubmit))
+      return kIOReturnBadArgument;
+   const uint32_t header[2] = {DW_TUNNEL_MAGIC, method};
+   memcpy(buffer, header, sizeof(header));
+   if (in_size)
+      memcpy(buffer + sizeof(header), in, in_size);
+   return IOConnectCallStructMethod(dw.conn, dw.selector, buffer, sizeof(header) + in_size, out_size ? out : NULL,
+                                    out_size ? &out_bytes : NULL);
+}
+
+static void
+darwin_profile_name(char *target, size_t capacity, const char *name)
+{
+   snprintf(target, capacity, "%s", name ? name : "unnamed");
+}
+
+static unsigned
+darwin_profile_size_bin(uint64_t bytes)
+{
+   unsigned index = 0;
+   uint64_t upper = 4096;
+   while (index + 1 < NativeAdrenoBoProfileSizeCount && bytes > upper) {
+      ++index;
+      upper <<= 1;
+   }
+   return index;
+}
+
+static unsigned
+darwin_profile_usage_bin(struct darwin_retire_state *retire, const char *name)
+{
+   char key[32] = {};
+   darwin_profile_name(key, sizeof(key), name);
+   for (unsigned i = 0; i + 1 < NativeAdrenoBoProfileUsageCount; ++i) {
+      if (!retire->usages[i].requests || !strcmp(retire->usages[i].name, key)) {
+         memcpy(retire->usages[i].name, key, sizeof(key));
+         return i;
+      }
+   }
+   return NativeAdrenoBoProfileUsageCount - 1;
+}
+
+/* The slow-event record captures the complete allocation or release call.
+ * Its fence is the connection's conservative retirement fence, not a measured
+ * last use of this BO. The caller holds retire->lock while appending a record. */
+static void
+darwin_profile_slow_locked(struct darwin_retire_state *retire, uint64_t began,
+                          NativeAdrenoAbiBoSlowEvent event, VkResult result)
+{
+   const uint64_t ended = os_time_get_nano() / 1000;
+   if (ended < began || ended - began < 8000) {
+      return;
+   }
+
+   const uint64_t sequence = ++retire->profile.slow_total;
+   if (sequence > NativeAdrenoBoProfileSlowCount) {
+      ++retire->profile.slow_overwritten;
+   }
+   event.elapsed_us = ended - began;
+   event.cached_objects = retire->cache_count;
+   event.cached_bytes = retire->cache_bytes;
+   event.pending_objects = retire->count;
+   event.pending_bytes = retire->pending_bytes;
+   event.status = (uint32_t)result;
+   NativeAdrenoAbiBoProfile *record = &retire->slow[(sequence - 1) % NativeAdrenoBoProfileSlowCount];
+   *record = {};
+   record->version = NativeAdrenoBoProfileVersion;
+   record->kind = NativeAdrenoBoProfileSlow;
+   record->index = (sequence - 1) % NativeAdrenoBoProfileSlowCount;
+   record->sequence = sequence;
+   record->sampled_us = ended;
+   record->device_id = retire->profile_device;
+   record->data.slow = event;
+}
+
+static NativeAdrenoAbiBoSlowEvent
+darwin_profile_bo_event(const struct darwin_retired_bo *bo, unsigned operation)
+{
+   NativeAdrenoAbiBoSlowEvent event = {};
+   event.operation = operation;
+   event.bytes = bo->size;
+   event.alignment = bo->alignment;
+   event.handle = bo->handle;
+   event.iova = bo->iova;
+   event.alloc_flags = bo->alloc_flags;
+   event.memory_property = bo->mem_property;
+   event.connection_fence = bo->fence;
+   event.cache_reason = NativeAdrenoBoCacheNotRequested;
+   memcpy(event.name, bo->name, sizeof(event.name));
+   return event;
+}
+
+static kern_return_t
+darwin_send_profile(const struct darwin_retire_state *retire, const NativeAdrenoAbiBoProfile *record)
+{
+   if (!retire->profile_tunnel) {
+      return IOConnectCallStructMethod(retire->profile_connection, NativeAdrenoMethodReportBoProfile,
+                                       record, sizeof(*record), NULL, NULL);
+   }
+   uint8_t buffer[8 + sizeof(*record)];
+   const uint32_t header[2] = {DW_TUNNEL_MAGIC, NativeAdrenoMethodReportBoProfile};
+   memcpy(buffer, header, sizeof(header));
+   memcpy(buffer + sizeof(header), record, sizeof(*record));
+   return IOConnectCallStructMethod(retire->profile_connection, retire->profile_selector,
+                                    buffer, sizeof(buffer), NULL, NULL);
+}
+
+/* The reporter owns its snapshot until all records have been sent. Allocation
+ * threads only change counters and bounded arrays under retire->lock. No
+ * transport operation, USB output or sleeping occurs while that lock is held. */
+static void *
+darwin_profile_reporter(void *argument)
+{
+   struct darwin_retire_state *retire = (struct darwin_retire_state *)argument;
+   uint64_t sequence = 0;
+   uint64_t sent_slow = 0;
+   for (;;) {
+      NativeAdrenoAbiBoCacheCounters counters;
+      NativeAdrenoAbiBoCacheBin sizes[NativeAdrenoBoProfileSizeCount];
+      NativeAdrenoAbiBoCacheBin usages[NativeAdrenoBoProfileUsageCount];
+      NativeAdrenoAbiBoProfile slow[NativeAdrenoBoProfileSlowCount];
+      struct timespec deadline;
+      clock_gettime(CLOCK_REALTIME, &deadline);
+      deadline.tv_sec += 2;
+
+      pthread_mutex_lock(&retire->lock);
+      while (!retire->reporter_stop) {
+         if (pthread_cond_timedwait(&retire->report_wake, &retire->lock, &deadline) == ETIMEDOUT) {
+            break;
+         }
+      }
+      const bool stop = retire->reporter_stop;
+      counters = retire->profile;
+      counters.cached_objects = retire->cache_count;
+      counters.cached_bytes = retire->cache_bytes;
+      counters.peak_bytes = retire->cache_peak_bytes;
+      counters.pending_objects = retire->count;
+      counters.pending_bytes = retire->pending_bytes;
+      counters.pressure_waits = retire->pressure_waits;
+      counters.reaped = retire->reaped;
+      memcpy(sizes, retire->sizes, sizeof(sizes));
+      memcpy(usages, retire->usages, sizeof(usages));
+      memcpy(slow, retire->slow, sizeof(slow));
+      pthread_mutex_unlock(&retire->lock);
+
+      NativeAdrenoAbiBoProfile record = {};
+      record.version = NativeAdrenoBoProfileVersion;
+      record.sequence = ++sequence;
+      record.device_id = retire->profile_device;
+      record.sampled_us = os_time_get_nano() / 1000;
+      record.kind = NativeAdrenoBoProfileCounters;
+      record.data.counters = counters;
+      uint64_t failures = darwin_send_profile(retire, &record) != KERN_SUCCESS;
+      for (unsigned i = 0; i < NativeAdrenoBoProfileSizeCount; ++i) {
+         if (!sizes[i].requests) {
+            continue;
+         }
+         record.kind = NativeAdrenoBoProfileSize;
+         record.index = i;
+         record.data.bin = sizes[i];
+         failures += darwin_send_profile(retire, &record) != KERN_SUCCESS;
+      }
+      for (unsigned i = 0; i < NativeAdrenoBoProfileUsageCount; ++i) {
+         if (!usages[i].requests) {
+            continue;
+         }
+         record.kind = NativeAdrenoBoProfileUsage;
+         record.index = i;
+         record.data.bin = usages[i];
+         failures += darwin_send_profile(retire, &record) != KERN_SUCCESS;
+      }
+      const uint64_t first = MAX2(sent_slow + 1,
+         counters.slow_total > NativeAdrenoBoProfileSlowCount ?
+         counters.slow_total - NativeAdrenoBoProfileSlowCount + 1 : 1);
+      for (uint64_t i = first; i <= counters.slow_total; ++i) {
+         const NativeAdrenoAbiBoProfile *event = &slow[(i - 1) % NativeAdrenoBoProfileSlowCount];
+         if (darwin_send_profile(retire, event) == KERN_SUCCESS) {
+            sent_slow = i;
+         } else {
+            ++failures;
+            break;
+         }
+      }
+      if (failures) {
+         pthread_mutex_lock(&retire->lock);
+         retire->profile.report_failures += failures;
+         pthread_mutex_unlock(&retire->lock);
+      }
+      if (stop) {
+         return NULL;
+      }
+   }
+}
