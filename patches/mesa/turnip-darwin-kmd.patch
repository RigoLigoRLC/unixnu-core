+/* ---- GPU address space: the client picks addresses out of [va_start, va_start + va_size). ---- */
+
+static VkResult
+darwin_allocate_iova(struct tu_device *dev, uint64_t size, uint64_t client_iova,
+                     enum tu_bo_alloc_flags flags, uint64_t *iova)
+{
+   *iova = 0;
+   mtx_lock(&dev->vma_mutex);
+   if (flags & TU_BO_ALLOC_REPLAYABLE) {
+      if (client_iova) {
+         if (util_vma_heap_alloc_addr(&dev->vma, client_iova, size))
+            *iova = client_iova;
+         else {
+            mtx_unlock(&dev->vma_mutex);
+            return VK_ERROR_INVALID_OPAQUE_CAPTURE_ADDRESS;
+         }
+      } else {
+         dev->vma.alloc_high = true;
+         *iova = util_vma_heap_alloc(&dev->vma, size, os_page_size);
+      }
+   } else {
+      dev->vma.alloc_high = false;
+      *iova = util_vma_heap_alloc(&dev->vma, size, os_page_size);
+   }
+   mtx_unlock(&dev->vma_mutex);
+   return *iova ? VK_SUCCESS : VK_ERROR_OUT_OF_DEVICE_MEMORY;
+}
+
+static void
+darwin_free_iova(struct tu_device *dev, uint64_t iova, uint64_t size)
+{
+   mtx_lock(&dev->vma_mutex);
+   util_vma_heap_free(&dev->vma, iova, size);
+   mtx_unlock(&dev->vma_mutex);
+}
+
+/* The caller holds retire->lock and has observed this BO's fence completion.
+ * A busy kernel handle keeps its ID and GPU address for the next collection. */
+static VkResult
+darwin_release_bo_storage_locked(struct tu_device *dev, struct darwin_retire_state *retire,
+                                 struct darwin_retired_bo *bo)
+{
+   if (bo->token) {
+      if (bo->mapping) {
+         kern_return_t kr = IOConnectUnmapMemory64(dw.conn, bo->token, mach_task_self(),
+                                                  (mach_vm_address_t)(uintptr_t)bo->mapping);
+         if (kr != KERN_SUCCESS) {
+            return retire->failure = vk_device_set_lost(&dev->vk, "deferred CPU unmap failed: 0x%x", kr);
+         }
+         bo->mapping = NULL;
+      }
+
+      NativeAdrenoAbiBoCpuUnmap undo = {.handle = bo->handle, .token = bo->token};
+      kern_return_t kr = dw_call(NativeAdrenoMethodBoCpuUnmap, &undo, sizeof(undo), NULL, 0);
+      if (kr != KERN_SUCCESS) {
+         return retire->failure = vk_device_set_lost(&dev->vk, "deferred CPU lease release failed: 0x%x", kr);
+      }
+      bo->token = 0;
+   }
+
+   NativeAdrenoAbiBoFree release = {.handle = bo->handle};
+   kern_return_t kr = dw_call(NativeAdrenoMethodBoFree, &release, sizeof(release), NULL, 0);
+   if (kr == kIOReturnBusy) {
+      return VK_NOT_READY;
+   }
+   if (kr != KERN_SUCCESS) {
+      return retire->failure = vk_device_set_lost(&dev->vk, "deferred BoFree failed: 0x%x", kr);
+   }
+
+   darwin_free_iova(dev, bo->iova, bo->size);
+   util_idalloc_free(&retire->ids, bo->gem_handle);
+   *bo = {};
+
+   return VK_SUCCESS;
+}
+
+static VkResult
+darwin_release_bo_locked(struct tu_device *dev, struct darwin_retire_state *retire,
+                         struct darwin_retired_bo *bo)
+{
+   const uint64_t began = os_time_get_nano() / 1000;
+   const NativeAdrenoAbiBoSlowEvent event = darwin_profile_bo_event(bo, NativeAdrenoBoSlowRelease);
+   VkResult result = darwin_release_bo_storage_locked(dev, retire, bo);
+   darwin_profile_slow_locked(retire, began, event, result);
+   return result;
+}
+
+static void
+darwin_remove_cached_locked(struct darwin_retire_state *retire, unsigned index, uint64_t size)
+{
+   --retire->cache_count;
+   memmove(&retire->cache[index], &retire->cache[index + 1],
+           (retire->cache_count - index) * sizeof(retire->cache[0]));
+   retire->cache[retire->cache_count] = {};
+   retire->cache_bytes -= size;
+}
+
+enum darwin_cache_evict_reason {
+   DARWIN_EVICT_OBJECTS,
+   DARWIN_EVICT_BYTES,
+   DARWIN_EVICT_IOVA,
+   DARWIN_EVICT_ALLOCATION,
+   DARWIN_EVICT_CLOSE,
+};
+
+static VkResult
+darwin_evict_oldest_locked(struct tu_device *dev, struct darwin_retire_state *retire,
+                           enum darwin_cache_evict_reason reason)
+{
+   uint64_t size = retire->cache[0].size;
+   VkResult result = darwin_release_bo_locked(dev, retire, &retire->cache[0]);
+   if (result != VK_SUCCESS) {
+      return result;
+   }
+
+   darwin_remove_cached_locked(retire, 0, size);
+   ++retire->cache_evictions;
+   switch (reason) {
+   case DARWIN_EVICT_OBJECTS:
+      ++retire->profile.evict_objects;
+      break;
+   case DARWIN_EVICT_BYTES:
+      ++retire->profile.evict_bytes;
+      break;
+   case DARWIN_EVICT_IOVA:
+      ++retire->profile.evict_iova;
+      break;
+   case DARWIN_EVICT_ALLOCATION:
+      ++retire->profile.evict_allocation;
+      break;
+   case DARWIN_EVICT_CLOSE:
+      ++retire->profile.evict_close;
+      break;
+   }
+
+   return VK_SUCCESS;
+}
+
+static VkResult
+darwin_cache_completed_locked(struct tu_device *dev, struct darwin_retire_state *retire,
+                              struct darwin_retired_bo *bo)
+{
+   if (!bo->cacheable) {
+      return darwin_release_bo_locked(dev, retire, bo);
+   }
+
+   while (retire->cache_count == DARWIN_CACHED_BOS ||
+          bo->size > DARWIN_BO_CACHE_BYTES - retire->cache_bytes) {
+      const enum darwin_cache_evict_reason reason = retire->cache_count == DARWIN_CACHED_BOS ?
+         DARWIN_EVICT_OBJECTS : DARWIN_EVICT_BYTES;
+      VkResult result = darwin_evict_oldest_locked(dev, retire, reason);
+      if (result != VK_SUCCESS) {
+         return result;
+      }
+   }
+
+   retire->cache[retire->cache_count++] = *bo;
+   retire->cache_bytes += bo->size;
+   retire->cache_peak_bytes = MAX2(retire->cache_peak_bytes, retire->cache_bytes);
+   retire->profile.peak_objects = MAX2(retire->profile.peak_objects, retire->cache_count);
+   ++retire->profile.puts;
+   *bo = {};
+
+   return VK_SUCCESS;
+}
+
+/* The caller holds retire->lock. Every fence poll uses a zero timeout. */
+static VkResult
+darwin_reap_locked(struct tu_device *dev, struct darwin_retire_state *retire)
+{
+   if (retire->failure != VK_SUCCESS)
+      return retire->failure;
+   /* Cache only within this sweep. Persisting a bare 32-bit fence across sweeps
+    * could mistake a later wrapped value for an old observed completion. */
+   uint32_t completed_fence = 0;
+   bool have_completed_fence = false;
+   while (retire->count) {
+      struct darwin_retired_bo *bo = &retire->entries[retire->head];
+      if (bo->fence && (!have_completed_fence || bo->fence != completed_fence)) {
+         VkResult result = dw_wait_fence_raw(dev, bo->fence, 0);
+         if (result == VK_TIMEOUT)
+            return VK_SUCCESS;
+         if (result != VK_SUCCESS)
+            return retire->failure = result;
+         have_completed_fence = true;
+         completed_fence = bo->fence;
+      }
+      const uint64_t bytes = bo->size;
+      VkResult result = darwin_cache_completed_locked(dev, retire, bo);
+      if (result == VK_NOT_READY) {
+         return VK_SUCCESS;
+      }
+      if (result != VK_SUCCESS) {
+         return result;
+      }
+
+      retire->head = (retire->head + 1) % DARWIN_RETIRED_BOS;
+      --retire->count;
+      retire->pending_bytes -= bytes;
+      ++retire->reaped;
+   }
+   return VK_SUCCESS;
+}
+
+static VkResult
+darwin_collect_retired(struct tu_device *dev)
+{
+   struct darwin_retire_state *retire = (struct darwin_retire_state *)dev->darwin_retire;
+   pthread_mutex_lock(&retire->lock);
+   VkResult result = darwin_reap_locked(dev, retire);
+   pthread_mutex_unlock(&retire->lock);
+   return result;
+}
+
+static uint32_t
+darwin_allocate_bo_id(struct tu_device *dev)
+{
+   struct darwin_retire_state *retire = (struct darwin_retire_state *)dev->darwin_retire;
+   pthread_mutex_lock(&retire->lock);
+   uint32_t id = util_idalloc_alloc(&retire->ids);
+   pthread_mutex_unlock(&retire->lock);
+
+   return id;
+}
+
+static bool
+darwin_bo_matches(const struct darwin_retired_bo *bo, uint64_t size, uint64_t alignment,
+                  uint32_t alloc_flags, VkMemoryPropertyFlags mem_property)
+{
+   return bo->cacheable && bo->size == size && bo->alignment == alignment &&
+          bo->alloc_flags == alloc_flags && bo->mem_property == mem_property;
+}
+
+static VkResult
+darwin_take_cached(struct tu_device *dev, uint64_t size, uint64_t alignment,
+                    uint32_t alloc_flags, VkMemoryPropertyFlags mem_property,
+                    bool eligible, const char *name, uint32_t *reason,
+                    struct darwin_retired_bo *out)
+{
+   struct darwin_retire_state *retire = (struct darwin_retire_state *)dev->darwin_retire;
+   pthread_mutex_lock(&retire->lock);
+   NativeAdrenoAbiBoCacheCounters *profile = &retire->profile;
+   NativeAdrenoAbiBoCacheBin *size_bin = &retire->sizes[darwin_profile_size_bin(size)];
+   NativeAdrenoAbiBoCacheBin *usage_bin = &retire->usages[darwin_profile_usage_bin(retire, name)];
+   ++profile->requests;
+   profile->requested_bytes += size;
+   ++size_bin->requests;
+   size_bin->requested_bytes += size;
+   ++usage_bin->requests;
+   usage_bin->requested_bytes += size;
+   if (eligible) {
+      ++profile->eligible;
+      ++size_bin->eligible;
+      ++usage_bin->eligible;
+   } else if (*reason == NativeAdrenoBoCacheFixedAddress) {
+      ++profile->bypass_fixed;
+   } else if (*reason == NativeAdrenoBoCacheExcludedFlags) {
+      ++profile->bypass_flags;
+   } else {
+      ++profile->bypass_oversize;
+   }
+
+   VkResult result = darwin_reap_locked(dev, retire);
+   if (result == VK_SUCCESS && eligible) {
+      bool same_size = false;
+      bool same_alignment = false;
+      bool same_flags = false;
+      for (unsigned i = 0; i < retire->cache_count; ++i) {
+         const struct darwin_retired_bo *bo = &retire->cache[i];
+         if (bo->size != size) {
+            continue;
+         }
+         same_size = true;
+         if (bo->alignment != alignment) {
+            continue;
+         }
+         same_alignment = true;
+         if (bo->alloc_flags != alloc_flags) {
+            continue;
+         }
+         same_flags = true;
+         if (bo->mem_property != mem_property) {
+            continue;
+         }
+
+         *out = *bo;
+         darwin_remove_cached_locked(retire, i, size);
+         ++retire->cache_hits;
+         ++profile->hits;
+         ++size_bin->hits;
+         ++usage_bin->hits;
+         *reason = NativeAdrenoBoCacheHit;
+         break;
+      }
+      if (!out->handle) {
+         ++retire->cache_misses;
+         ++profile->misses;
+         ++size_bin->misses;
+         ++usage_bin->misses;
+         bool compatible_pending = false;
+         for (unsigned i = 0; i < retire->count; ++i) {
+            const struct darwin_retired_bo *bo = &retire->entries[(retire->head + i) % DARWIN_RETIRED_BOS];
+            if (darwin_bo_matches(bo, size, alignment, alloc_flags, mem_property)) {
+               compatible_pending = true;
+               break;
+            }
+         }
+         /* A matching entry behind an unfinished queue head cannot be reused
+          * yet. No extra fence polling is introduced for measurement. */
+         if (compatible_pending) {
+            *reason = NativeAdrenoBoCachePending;
+            ++profile->miss_pending;
+            ++profile->compatible_pending_requests;
+            ++size_bin->compatible_pending_requests;
+            ++usage_bin->compatible_pending_requests;
+         } else if (!retire->cache_count) {
+            *reason = NativeAdrenoBoCacheEmpty;
+            ++profile->miss_empty;
+         } else if (!same_size) {
+            *reason = NativeAdrenoBoCacheSize;
+            ++profile->miss_size;
+         } else if (!same_alignment) {
+            *reason = NativeAdrenoBoCacheAlignment;
+            ++profile->miss_alignment;
+         } else if (!same_flags) {
+            *reason = NativeAdrenoBoCacheFlags;
+            ++profile->miss_flags;
+         } else {
+            *reason = NativeAdrenoBoCacheMemoryProperty;
+            ++profile->miss_memory_property;
+         }
+      }
+   } else if (result != VK_SUCCESS) {
+      *reason = NativeAdrenoBoCacheFailure;
+   }
+   pthread_mutex_unlock(&retire->lock);
+
+   return result;
+}
+
+/* Allocation pressure releases only completed cached objects. Pending fences
+ * remain in the retirement queue and are polled by later collections. */
+static VkResult
+darwin_trim_cache(struct tu_device *dev, enum darwin_cache_evict_reason reason)
+{
+   struct darwin_retire_state *retire = (struct darwin_retire_state *)dev->darwin_retire;
+   pthread_mutex_lock(&retire->lock);
+   VkResult result = retire->failure;
+   while (result == VK_SUCCESS && retire->cache_count) {
+      result = darwin_evict_oldest_locked(dev, retire, reason);
+   }
+   pthread_mutex_unlock(&retire->lock);
+
+   return result == VK_NOT_READY ? VK_SUCCESS : result;
+}
+
+static VkResult
+darwin_map_failure(struct tu_device *dev, uint64_t handle, uint64_t iova,
+                   uint64_t size, kern_return_t map_error)
+{
+   NativeAdrenoAbiBoFree release = {.handle = handle};
+   kern_return_t cleanup = dw_call(NativeAdrenoMethodBoFree, &release, sizeof(release), NULL, 0);
+   if (cleanup == KERN_SUCCESS) {
+      darwin_free_iova(dev, iova, size);
+      return vk_errorf(dev, VK_ERROR_OUT_OF_DEVICE_MEMORY, "BoMap failed: 0x%x", map_error);
+   }
+   /* A failed map may have modified tables. Unknown cleanup never authorizes
+    * reusing its IOVA, even though no tu_bo could be published to the caller. */
+   struct darwin_retire_state *retire = (struct darwin_retire_state *)dev->darwin_retire;
+   pthread_mutex_lock(&retire->lock);
+   retire->failure = vk_device_set_lost(&dev->vk, "BoMap cleanup failed: 0x%x; retaining native allocation and IOVA", cleanup);
+   VkResult result = retire->failure;
+   pthread_mutex_unlock(&retire->lock);
+   return result;
+}
+
+/* ---- buffer objects ---- */
+
+static VkResult
+darwin_bo_init_recorded(struct tu_device *dev, struct vk_object_base *base,
+               struct tu_bo **out_bo, uint64_t size, uint64_t client_iova,
+               VkMemoryPropertyFlags mem_property,
+               enum tu_bo_alloc_flags flags, struct tu_sparse_vma *lazy_vma,
+               const char *name, uint32_t *cache_reason)
+{
+   MESA_TRACE_FUNC();
+   if (lazy_vma) {
+      return vk_error(dev, VK_ERROR_FEATURE_NOT_PRESENT);
+   }
+
+   const uint64_t alignment = os_page_size;
+   const uint32_t excluded_flags = TU_BO_ALLOC_REPLAYABLE | TU_BO_ALLOC_DMABUF |
+                                   TU_BO_ALLOC_SHAREABLE | TU_BO_ALLOC_IMPLICIT_SYNC;
+   const bool cacheable = !client_iova && !(flags & excluded_flags) &&
+                          size <= DARWIN_BO_CACHE_MAX_OBJECT_BYTES;
+   *cache_reason = client_iova ? NativeAdrenoBoCacheFixedAddress :
+      (flags & excluded_flags) ? NativeAdrenoBoCacheExcludedFlags : NativeAdrenoBoCacheOversize;
+   struct darwin_retired_bo storage = {};
+   VkResult result = darwin_take_cached(dev, size, alignment, flags, mem_property,
+                                       cacheable, name, cache_reason, &storage);
+   if (result != VK_SUCCESS) {
+      return result;
+   }
+
+   if (!storage.handle) {
+      uint64_t iova;
+      result = darwin_allocate_iova(dev, size, client_iova, flags, &iova);
+      if (result == VK_ERROR_OUT_OF_DEVICE_MEMORY ||
+          result == VK_ERROR_INVALID_OPAQUE_CAPTURE_ADDRESS) {
+         result = darwin_trim_cache(dev, DARWIN_EVICT_IOVA);
+         if (result != VK_SUCCESS) {
+            return result;
+         }
+         result = darwin_allocate_iova(dev, size, client_iova, flags, &iova);
+      }
+      if (result != VK_SUCCESS) {
+         return result;
+      }
+
+      NativeAdrenoAbiBoAlloc alloc = {.bytes = size, .align_log2 = 12, .contiguous = 0};
+      NativeAdrenoAbiBoAllocReply reply = {};
+      kern_return_t kr = dw_call(NativeAdrenoMethodBoAlloc, &alloc, sizeof(alloc), &reply, sizeof(reply));
+      if (kr != KERN_SUCCESS) {
+         result = darwin_trim_cache(dev, DARWIN_EVICT_ALLOCATION);
+         if (result != VK_SUCCESS) {
+            darwin_free_iova(dev, iova, size);
+            return result;
+         }
+         kr = dw_call(NativeAdrenoMethodBoAlloc, &alloc, sizeof(alloc), &reply, sizeof(reply));
+      }
+      if (kr != KERN_SUCCESS) {
+         darwin_free_iova(dev, iova, size);
+         return vk_errorf(dev, VK_ERROR_OUT_OF_DEVICE_MEMORY, "BoAlloc failed: 0x%x", kr);
+      }
+
+      NativeAdrenoAbiBoMap map = {
+         .handle = reply.handle,
+         .iova = iova,
+         .permissions = (flags & TU_BO_ALLOC_GPU_READ_ONLY) ? 1u : 3u,
+         .writeback = 0,
+         .shareability = 2,
+      };
+      NativeAdrenoAbiBoMapReply mapped = {};
+      kr = dw_call(NativeAdrenoMethodBoMap, &map, sizeof(map), &mapped, sizeof(mapped));
+      if (kr != KERN_SUCCESS) {
+         return darwin_map_failure(dev, reply.handle, iova, size, kr);
+      }
+
+      storage.handle = reply.handle;
+      storage.iova = iova;
+      storage.size = size;
+      storage.gem_handle = darwin_allocate_bo_id(dev);
+   }
+
+   struct tu_bo *bo = tu_device_lookup_bo(dev, storage.gem_handle);
+   assert(bo && bo->gem_handle == 0);
+
+   char purpose[32] = {};
+   darwin_profile_name(purpose, sizeof(purpose), name);
+   name = tu_debug_bos_add(dev, size, name);
+
+   *bo = (struct tu_bo) {
+      .gem_handle = storage.gem_handle,
+      .size = size,
+      .iova = storage.iova,
+      .map = storage.mapping,
+      .name = name,
+      .refcnt = 1,
+      .implicit_sync = !!(flags & TU_BO_ALLOC_IMPLICIT_SYNC),
+      .never_unmap = storage.mapping != NULL,
+      .base = base,
+      .unique_id = storage.handle,
+   };
+   bo->darwin_handle = storage.handle;
+   bo->darwin_token = storage.token;
+   bo->darwin_alloc_flags = flags;
+   bo->darwin_mem_property = mem_property;
+   bo->darwin_alignment = alignment;
+   bo->darwin_cacheable = cacheable;
+   bo->darwin_reused_map = storage.mapping != NULL;
+   memcpy(bo->darwin_profile_name, purpose, sizeof(purpose));
+
+   tu_dump_bo_init(dev, bo);
+   TU_RMV(bo_allocate, dev, bo);
+   if (bo->map) {
+      TU_RMV(bo_map, dev, bo);
+   }
+
+   *out_bo = bo;
+   if (flags & TU_BO_ALLOC_INTERNAL_RESOURCE) {
+      TU_RMV(internal_resource_create, dev, bo);
+      TU_RMV(resource_name, dev, bo, name);
+   }
+   return VK_SUCCESS;
+}
+
+static VkResult
+darwin_bo_init(struct tu_device *dev, struct vk_object_base *base,
+               struct tu_bo **out_bo, uint64_t size, uint64_t client_iova,
+               VkMemoryPropertyFlags mem_property,
+               enum tu_bo_alloc_flags flags, struct tu_sparse_vma *lazy_vma,
+               const char *name)
+{
+   const uint64_t began = os_time_get_nano() / 1000;
+   NativeAdrenoAbiBoSlowEvent event = {};
+   event.operation = NativeAdrenoBoSlowAllocate;
+   event.bytes = size;
+   event.alignment = os_page_size;
+   event.alloc_flags = flags;
+   event.memory_property = mem_property;
+   event.cache_reason = NativeAdrenoBoCacheFailure;
+   darwin_profile_name(event.name, sizeof(event.name), name);
+
+   VkResult result = darwin_bo_init_recorded(dev, base, out_bo, size, client_iova,
+                                            mem_property, flags, lazy_vma, name, &event.cache_reason);
+   if (result == VK_SUCCESS) {
+      event.handle = (*out_bo)->darwin_handle;
+      event.iova = (*out_bo)->iova;
+   }
+   struct darwin_retire_state *retire = (struct darwin_retire_state *)dev->darwin_retire;
+   pthread_mutex_lock(&retire->lock);
+   darwin_profile_slow_locked(retire, began, event, result);
+   pthread_mutex_unlock(&retire->lock);
+   return result;
+}
+
+/* VK_EXT_external_memory_host: the kernel pins the caller's pages (an IOSurface's) as a BO, which is then mapped into the GPU like any
+ * other. The CPU keeps the caller's own mapping, so there is no CPU-map token and the BO is "mapped" at the caller's pointer. */
+static VkResult
+darwin_bo_init_host_recorded(struct tu_device *dev, struct tu_bo **out_bo, void *pointer, uint64_t size)
+{
+   if (!(dw.params.flags & NativeAdrenoParamsHostImport))
+      return vk_error(dev, VK_ERROR_INVALID_EXTERNAL_HANDLE);
+   VkResult collected = darwin_collect_retired(dev);
+   if (collected != VK_SUCCESS)
+      return collected;
+   uint64_t iova;
+   VkResult result = darwin_allocate_iova(dev, size, 0, TU_BO_ALLOC_NO_FLAGS, &iova);
+   if (result == VK_ERROR_OUT_OF_DEVICE_MEMORY) {
+      result = darwin_trim_cache(dev, DARWIN_EVICT_IOVA);
+      if (result != VK_SUCCESS) {
+         return result;
+      }
+      result = darwin_allocate_iova(dev, size, 0, TU_BO_ALLOC_NO_FLAGS, &iova);
+   }
+   if (result != VK_SUCCESS) {
+      return result;
+   }
+
+   NativeAdrenoAbiBoImport import = {.address = (uint64_t)(uintptr_t)pointer, .bytes = size};
+   NativeAdrenoAbiBoAllocReply reply = {};
+   kern_return_t kr = dw_call(NativeAdrenoMethodBoImport, &import, sizeof(import), &reply, sizeof(reply));
+   if (kr == kIOReturnNoMemory || kr == kIOReturnNoResources) {
+      result = darwin_trim_cache(dev, DARWIN_EVICT_ALLOCATION);
+      if (result != VK_SUCCESS) {
+         darwin_free_iova(dev, iova, size);
+         return result;
+      }
+      kr = dw_call(NativeAdrenoMethodBoImport, &import, sizeof(import), &reply, sizeof(reply));
+   }
+   if (kr != KERN_SUCCESS) {
+      darwin_free_iova(dev, iova, size);
+      return vk_errorf(dev, VK_ERROR_INVALID_EXTERNAL_HANDLE, "BoImport failed: 0x%x", kr);
+   }
+   NativeAdrenoAbiBoMap map = {.handle = reply.handle, .iova = iova, .permissions = 3u, .writeback = 0, .shareability = 2};
+   NativeAdrenoAbiBoMapReply mapped = {};
+   kr = dw_call(NativeAdrenoMethodBoMap, &map, sizeof(map), &mapped, sizeof(mapped));
+   if (kr != KERN_SUCCESS) {
+      return darwin_map_failure(dev, reply.handle, iova, size, kr);
+   }
+
+   uint32_t gem_handle = darwin_allocate_bo_id(dev);
+   struct tu_bo *bo = tu_device_lookup_bo(dev, gem_handle);
+   assert(bo && bo->gem_handle == 0);
+   *bo = (struct tu_bo) {
+      .gem_handle = gem_handle,
+      .size = size,
+      .iova = iova,
+      .name = tu_debug_bos_add(dev, size, "host import"),
+      .refcnt = 1,
+      .unique_id = reply.handle,
+   };
+   bo->darwin_handle = reply.handle;
+   bo->darwin_token = 0;
+   bo->map = pointer;
+   bo->never_unmap = true;
+   darwin_profile_name(bo->darwin_profile_name, sizeof(bo->darwin_profile_name), "host import");
+   tu_dump_bo_init(dev, bo);
+   TU_RMV(bo_allocate, dev, bo);
+   *out_bo = bo;
+   return VK_SUCCESS;
+}
+
+static VkResult
+darwin_bo_init_host(struct tu_device *dev, struct tu_bo **out_bo, void *pointer, uint64_t size)
+{
+   const uint64_t began = os_time_get_nano() / 1000;
+   NativeAdrenoAbiBoSlowEvent event = {};
+   event.operation = NativeAdrenoBoSlowImport;
+   event.cache_reason = NativeAdrenoBoCacheImport;
+   event.bytes = size;
+   event.alignment = os_page_size;
+   darwin_profile_name(event.name, sizeof(event.name), "host import");
+   VkResult result = darwin_bo_init_host_recorded(dev, out_bo, pointer, size);
+   if (result == VK_SUCCESS) {
+      event.handle = (*out_bo)->darwin_handle;
+      event.iova = (*out_bo)->iova;
+   }
+   struct darwin_retire_state *retire = (struct darwin_retire_state *)dev->darwin_retire;
+   pthread_mutex_lock(&retire->lock);
+   ++retire->profile.imports;
+   retire->profile.import_bytes += size;
+   darwin_profile_slow_locked(retire, began, event, result);
+   pthread_mutex_unlock(&retire->lock);
+   return result;
+}
