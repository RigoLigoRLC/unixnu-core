+/* Waits until every submission made so far has retired, so a freed buffer cannot still be in flight. The kernel also
+ * retires completed jobs itself; this only covers the window before the GPU passes the last fence. */
+static VkResult
+darwin_wait_idle(struct tu_device *dev)
+{
+   pthread_mutex_lock(&dw.lock);
+   uint32_t last = dw.last_fence;
+   pthread_mutex_unlock(&dw.lock);
+   if (last)
+      return dw_wait_fence_locked_free(dev, last, os_time_get_nano() + 5000000000ull);
+   return VK_SUCCESS;
+}
+
+static void
+darwin_bo_finish(struct tu_device *dev, struct tu_bo *bo)
+{
+   const uint64_t began = os_time_get_nano() / 1000;
+   assert(bo->gem_handle);
+
+   u_rwlock_rdlock(&dev->dma_bo_lock);
+
+   if (!p_atomic_dec_zero(&bo->refcnt)) {
+      u_rwlock_rdunlock(&dev->dma_bo_lock);
+      return;
+   }
+
+   NativeAdrenoAbiBoSlowEvent event = {};
+   event.operation = NativeAdrenoBoSlowRetire;
+   event.bytes = bo->size;
+   event.alignment = bo->darwin_alignment;
+   event.handle = bo->darwin_handle;
+   event.iova = bo->iova;
+   event.alloc_flags = bo->darwin_alloc_flags;
+   event.memory_property = bo->darwin_mem_property;
+   event.cache_reason = NativeAdrenoBoCacheNotRequested;
+   memcpy(event.name, bo->darwin_profile_name, sizeof(event.name));
+   tu_debug_bos_del(dev, bo);
+   tu_dump_bo_del(dev, bo);
+
+   if (bo->map && bo->darwin_token)
+      TU_RMV(bo_unmap, dev, bo);
+   TU_RMV(bo_destroy, dev, bo);
+
+   struct darwin_retire_state *retire = (struct darwin_retire_state *)dev->darwin_retire;
+   pthread_mutex_lock(&retire->lock);
+   darwin_reap_locked(dev, retire);
+   if (retire->count == DARWIN_RETIRED_BOS && retire->failure == VK_SUCCESS) {
+      ++retire->pressure_waits;
+      pthread_mutex_unlock(&retire->lock);
+      VkResult waited = darwin_wait_idle(dev);
+      pthread_mutex_lock(&retire->lock);
+      if (waited != VK_SUCCESS)
+         retire->failure = vk_device_set_lost(&dev->vk, "deferred BO pressure wait failed");
+      else
+         darwin_reap_locked(dev, retire);
+   }
+   if (retire->count < DARWIN_RETIRED_BOS) {
+      pthread_mutex_lock(&dw.lock);
+      uint32_t fence = dw.last_fence;
+      pthread_mutex_unlock(&dw.lock);
+      event.connection_fence = fence;
+      unsigned slot = (retire->head + retire->count) % DARWIN_RETIRED_BOS;
+      retire->entries[slot] = {
+         .handle = bo->darwin_handle,
+         .iova = bo->iova,
+         .size = bo->size,
+         .mapping = bo->map,
+         .token = bo->darwin_token,
+         .fence = fence,
+         .gem_handle = bo->gem_handle,
+         .alloc_flags = bo->darwin_alloc_flags,
+         .mem_property = bo->darwin_mem_property,
+         .alignment = bo->darwin_alignment,
+         .cacheable = bo->darwin_cacheable,
+      };
+      memcpy(retire->entries[slot].name, event.name, sizeof(event.name));
+      ++retire->count;
+      ++retire->enqueued;
+      retire->pending_bytes += bo->size;
+
+      /* The sparse-array entry becomes empty before another allocation can
+       * obtain this handle from the completed cache. */
+      memset(bo, 0, sizeof(*bo));
+      darwin_reap_locked(dev, retire);
+   } else {
+      /* No reusable range is reported on error. The kernel still owns the handle
+       * and view; connection teardown must drain them, even if this record cannot fit. */
+      retire->failure = vk_device_set_lost(&dev->vk, "deferred BO queue remains full; retaining native allocation");
+      memset(bo, 0, sizeof(*bo));
+   }
+   darwin_profile_slow_locked(retire, began, event, retire->failure);
+   pthread_mutex_unlock(&retire->lock);
+
+   u_rwlock_rdunlock(&dev->dma_bo_lock);
+}
