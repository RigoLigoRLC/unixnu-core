+static bool
+capture_write_file(const std::string &path, const void *bytes, size_t size)
+{
+   std::string temporary = path + ".part";
+   int descriptor = open(temporary.c_str(), O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW, 0600);
+   if (descriptor < 0) {
+      return false;
+   }
+
+   size_t at = 0;
+   while (at < size) {
+      ssize_t written = write(descriptor, static_cast<const char *>(bytes) + at, size - at);
+      if (written < 0 && errno == EINTR) {
+         continue;
+      }
+      if (written <= 0) {
+         break;
+      }
+      at += written;
+   }
+
+   bool complete = at == size;
+   if (close(descriptor)) {
+      complete = false;
+   }
+   if (complete && !rename(temporary.c_str(), path.c_str())) {
+      return true;
+   }
+   unlink(temporary.c_str());
+   return false;
 }
+
+static void
+capture_status(ShaderCaptureFiles &files)
+{
+   char status[768];
+   int size = snprintf(status, sizeof(status),
+      "{\"version\":1,\"pid\":%d,\"session_id\":%llu,\"files\":%llu,"
+      "\"input_bytes\":%llu,\"spirv_metadata_bytes\":%llu,\"driver_bytes\":%llu,"
+      "\"refused\":%llu,\"write_failures\":%llu,\"last_reason\":\"%s\","
+      "\"file_limit\":4096,\"single_file_limit\":16777216,"
+      "\"input_limit\":33554432,\"spirv_metadata_limit\":33554432,"
+      "\"driver_limit\":67108864}\n",
+      getpid(), (unsigned long long)files.session, (unsigned long long)files.files,
+      (unsigned long long)files.bytes[0], (unsigned long long)files.bytes[1],
+      (unsigned long long)files.bytes[2], (unsigned long long)files.refused,
+      (unsigned long long)files.failures, files.reason);
+   capture_write_file(files.prefix + "status.json", status, size);
+}
+
+VKAPI_ATTR uint64_t VKAPI_CALL
+tu_NativeAdrenoShaderCaptureWrite(VkDevice device, const char *name,
+                                 const void *bytes, size_t size)
+{
+   (void)device;
+   ShaderCaptureFiles &files = shader_capture_files();
+   if (files.prefix.empty()) {
+      return 0;
+   }
+   std::lock_guard<std::mutex> guard(files.lock);
+   if (!name) {
+      capture_status(files);
+      return files.session;
+   }
+
+   size_t length = strnlen(name, 161);
+   bool valid = length && length <= 160 && bytes;
+   for (size_t i = 0; valid && i < length; ++i) {
+      char c = name[i];
+      valid = (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') ||
+              c == '-' || c == '_' || c == '.';
+   }
+   valid = valid && !strstr(name, "..");
+
+   std::string path = files.prefix + name;
+   if (valid && !access(path.c_str(), F_OK)) {
+      return files.session;
+   }
+
+   unsigned category = !strncmp(name, "input-", 6) ? 0 :
+                       !strncmp(name, "driver-", 7) ? 2 : 1;
+   const uint64_t limits[] = {32ull << 20, 32ull << 20, 64ull << 20};
+   if (!valid || size > (16ull << 20) || files.files >= 4095 ||
+       size > limits[category] - files.bytes[category]) {
+      ++files.refused;
+      files.reason = !valid ? "invalid-name" : size > (16ull << 20) ?
+         "single-file-limit" : files.files >= 4095 ? "file-count-limit" :
+         category == 0 ? "input-byte-limit" : category == 1 ?
+         "spirv-metadata-byte-limit" : "driver-byte-limit";
+      capture_status(files);
+      return 0;
+   }
+
+   if (!capture_write_file(path, bytes, size)) {
+      ++files.failures;
+      files.reason = "write-failed";
+      capture_status(files);
+      return 0;
+   }
+
+   ++files.files;
+   files.bytes[category] += size;
+   files.reason = "written";
+   capture_status(files);
+   return files.session;
+}
