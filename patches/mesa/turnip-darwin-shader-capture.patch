+/* ShaderCaptureFiles owns one process's bounded output directory. Its writer
+ * publishes completed files with rename and records refusals in a status file.
+ * AIR libraries, translator output and driver output have separate byte budgets.
+ */
+struct ShaderCaptureFiles {
+   std::mutex lock;
+   std::string prefix;
+   uint64_t session = 0;
+   uint64_t bytes[3] = {};
+   uint64_t files = 0;
+   uint64_t refused = 0;
+   uint64_t failures = 0;
+   const char *reason = "initializing";
+
+   ShaderCaptureFiles()
+   {
+      const char *root = "/private/var/mobile/Library/Caches/NativeAdrenoShaderCapture";
+      const char *marker = "/private/var/ngpu/addons/NativeAdrenoMetal.shadercapture";
+      std::string enabled = std::string(root) + "/enabled";
+      if (access(marker, R_OK) && access(enabled.c_str(), R_OK)) {
+         reason = "disabled";
+         return;
+      }
+
+      mkdir(root, 0777);
+      chmod(root, 0777);
+      std::string directory = std::string(root) + "/" + std::to_string(getpid());
+      mkdir(directory.c_str(), 0700);
+      if (access(directory.c_str(), W_OK)) {
+         reason = "directory-not-writable";
+         return;
+      }
+
+      struct timespec now = {};
+      clock_gettime(CLOCK_MONOTONIC, &now);
+      session = uint64_t(now.tv_sec) * 1000000000ull + now.tv_nsec;
+      prefix = directory + "/s" + std::to_string(session) + "_";
+      reason = "enabled";
+   }
+};
