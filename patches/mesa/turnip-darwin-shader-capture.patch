+VKAPI_ATTR uint64_t VKAPI_CALL
+tu_NativeAdrenoShaderCapturePipelineId(VkDevice device, VkPipeline handle)
+{
+   (void)device;
+   VK_FROM_HANDLE(tu_pipeline, pipeline, handle);
+   return pipeline ? pipeline->shader_capture_id : 0;
+}
+
+const char *
+tu_NativeAdrenoShaderCapturePrefix(void)
+{
+   return shader_capture_files().prefix.c_str();
+}
+
+/* capture_pipeline reads the driver's existing KHR executable representations.
+ * Each record names the actual VkPipeline and an allocation-specific ID, so a
+ * later pipeline reusing its address remains distinguishable in the capture.
+ */
+static void
+capture_pipeline(VkDevice device, VkPipeline handle,
+                  VkPipelineCreateFlags2KHR flags, uint32_t feedback_flags,
+                  const VkPipelineShaderStageCreateInfo *stages,
+                  uint32_t stage_count, const void *next)
+{
+   VK_FROM_HANDLE(tu_pipeline, pipeline, handle);
+   static std::atomic<uint64_t> next_id{1};
+   pipeline->shader_capture_id = next_id.fetch_add(1);
+   std::string stem = "driver-pipeline-" + std::to_string(pipeline->shader_capture_id);
+   VkPipelineInfoKHR info = {};
+   info.sType = VK_STRUCTURE_TYPE_PIPELINE_INFO_KHR;
+   info.pipeline = handle;
+   uint32_t count = 0;
+   VkResult result = tu_GetPipelineExecutablePropertiesKHR(device, &info, &count, NULL);
+   if (result != VK_SUCCESS || count > 32) {
+      std::string error = "version=1\ncapture_id=" + std::to_string(pipeline->shader_capture_id) +
+         "\nexecutable_query_result=" + std::to_string(result) +
+         "\nexecutable_count=" + std::to_string(count) + "\n";
+      tu_NativeAdrenoShaderCaptureWrite(device, (stem + ".txt").c_str(), error.data(), error.size());
+      return;
+   }
+
+   std::vector<VkPipelineExecutablePropertiesKHR> executables(count);
+   for (auto &entry : executables) {
+      entry.sType = VK_STRUCTURE_TYPE_PIPELINE_EXECUTABLE_PROPERTIES_KHR;
+   }
+   result = tu_GetPipelineExecutablePropertiesKHR(device, &info, &count, executables.data());
+   std::string metadata = "version=1\npid=" + std::to_string(getpid()) +
+      "\ncapture_id=" + std::to_string(pipeline->shader_capture_id) +
+      "\nvk_pipeline=" + std::to_string((uintptr_t)handle) +
+      "\ncreate_flags=" + std::to_string(flags) +
+      "\ncreation_feedback_flags=" + std::to_string(feedback_flags) +
+      "\napplication_pipeline_cache_hit=" +
+         (feedback_flags == UINT32_MAX ? std::string("unreported") :
+          std::to_string(!!(feedback_flags & VK_PIPELINE_CREATION_FEEDBACK_APPLICATION_PIPELINE_CACHE_HIT_BIT))) +
+      "\nquery_result=" + std::to_string(result) + "\n";
+
+   const VkPipelineLibraryCreateInfoKHR *libraries =
+      vk_find_struct_const(next, PIPELINE_LIBRARY_CREATE_INFO_KHR);
+   if (libraries) {
+      for (uint32_t i = 0; i < libraries->libraryCount; ++i) {
+         metadata += "linked_pipeline_capture_id=" + std::to_string(
+            tu_NativeAdrenoShaderCapturePipelineId(device, libraries->pLibraries[i])) + "\n";
+      }
+   }
+   for (uint32_t i = 0; i < stage_count; ++i) {
+      VK_FROM_HANDLE(vk_shader_module, module, stages[i].module);
+      metadata += "source_stage=" + std::to_string(stages[i].stage) +
+         " entry=" + (stages[i].pName ? stages[i].pName : "") +
+         " module=" + std::to_string((uintptr_t)stages[i].module) + "\n";
+      if (module && module->size) {
+         static const char digits[] = "0123456789abcdef";
+         std::string identity;
+         for (unsigned j = 0; j < sizeof(module->hash); ++j) {
+            uint8_t byte = reinterpret_cast<const uint8_t *>(&module->hash)[j];
+            identity += digits[byte >> 4];
+            identity += digits[byte & 15];
+         }
+         std::string file = "spirv-input-" + identity + ".spv";
+         uint64_t saved = tu_NativeAdrenoShaderCaptureWrite(device, file.c_str(),
+            module->data, module->size);
+         metadata += "spirv=" + file + " saved=" + std::to_string(saved != 0) + "\n";
+      }
+      const VkSpecializationInfo *specialization = stages[i].pSpecializationInfo;
+      if (specialization) {
+         const uint8_t *values = static_cast<const uint8_t *>(specialization->pData);
+         for (uint32_t j = 0; j < specialization->mapEntryCount; ++j) {
+            const VkSpecializationMapEntry &entry = specialization->pMapEntries[j];
+            metadata += "spec id=" + std::to_string(entry.constantID) +
+               " offset=" + std::to_string(entry.offset) +
+               " size=" + std::to_string(entry.size) + " bytes=";
+            if (entry.offset <= specialization->dataSize &&
+                entry.size <= specialization->dataSize - entry.offset) {
+               for (size_t k = 0; k < entry.size; ++k) {
+                  char byte[3];
+                  snprintf(byte, sizeof(byte), "%02x", values[entry.offset + k]);
+                  metadata += byte;
+               }
+            }
+            metadata += "\n";
+         }
+      }
+   }
+
+   for (uint32_t i = 0; result == VK_SUCCESS && i < count; ++i) {
+      VkPipelineExecutableInfoKHR executable = {};
+      executable.sType = VK_STRUCTURE_TYPE_PIPELINE_EXECUTABLE_INFO_KHR;
+      executable.pipeline = handle;
+      executable.executableIndex = i;
+      std::string stage = stem + "-stage-" + std::to_string(i);
+      metadata += "executable=" + std::to_string(i) + " name=" + executables[i].name +
+         " stages=" + std::to_string(executables[i].stages) +
+         " subgroup=" + std::to_string(executables[i].subgroupSize) + "\n";
+
+      uint32_t statistics_count = 0;
+      VkResult statistics_result = tu_GetPipelineExecutableStatisticsKHR(
+         device, &executable, &statistics_count, NULL);
+      if (statistics_result == VK_SUCCESS && statistics_count <= 128) {
+         std::vector<VkPipelineExecutableStatisticKHR> statistics(statistics_count);
+         for (auto &statistic : statistics) {
+            statistic.sType = VK_STRUCTURE_TYPE_PIPELINE_EXECUTABLE_STATISTIC_KHR;
+         }
+         statistics_result = tu_GetPipelineExecutableStatisticsKHR(
+            device, &executable, &statistics_count, statistics.data());
+         for (const auto &statistic : statistics) {
+            std::string value;
+            switch (statistic.format) {
+               case VK_PIPELINE_EXECUTABLE_STATISTIC_FORMAT_BOOL32_KHR:
+                  value = std::to_string(statistic.value.b32);
+                  break;
+               case VK_PIPELINE_EXECUTABLE_STATISTIC_FORMAT_INT64_KHR:
+                  value = std::to_string(statistic.value.i64);
+                  break;
+               case VK_PIPELINE_EXECUTABLE_STATISTIC_FORMAT_UINT64_KHR:
+                  value = std::to_string(statistic.value.u64);
+                  break;
+               case VK_PIPELINE_EXECUTABLE_STATISTIC_FORMAT_FLOAT64_KHR:
+                  value = std::to_string(statistic.value.f64);
+                  break;
+               default:
+                  value = "unsupported";
+                  break;
+            }
+            metadata += "stat stage=" + std::to_string(i) + " name=" + statistic.name +
+               " value=" + value + " description=" + statistic.description + "\n";
+         }
+      }
+
+      uint32_t ir_count = 0;
+      VkResult ir_result = tu_GetPipelineExecutableInternalRepresentationsKHR(
+         device, &executable, &ir_count, NULL);
+      if (ir_result != VK_SUCCESS || ir_count > 8) {
+         metadata += "ir-query-failed=" + std::to_string(ir_result) + "\n";
+         continue;
+      }
+      std::vector<VkPipelineExecutableInternalRepresentationKHR> representations(ir_count);
+      for (auto &ir : representations) {
+         ir.sType = VK_STRUCTURE_TYPE_PIPELINE_EXECUTABLE_INTERNAL_REPRESENTATION_KHR;
+      }
+      ir_result = tu_GetPipelineExecutableInternalRepresentationsKHR(
+         device, &executable, &ir_count, representations.data());
+      std::vector<std::vector<char>> buffers(ir_count);
+      for (uint32_t j = 0; j < ir_count; ++j) {
+         if (representations[j].dataSize > (16u << 20)) {
+            metadata += "ir-too-large=" + std::to_string(j) + "\n";
+            continue;
+         }
+         buffers[j].resize(representations[j].dataSize);
+         representations[j].pData = buffers[j].data();
+      }
+      ir_result = tu_GetPipelineExecutableInternalRepresentationsKHR(
+         device, &executable, &ir_count, representations.data());
+      for (uint32_t j = 0; j < ir_count; ++j) {
+         if (buffers[j].empty()) {
+            continue;
+         }
+         std::string file = stage + "-ir-" + std::to_string(j) + ".txt";
+         uint64_t saved = tu_NativeAdrenoShaderCaptureWrite(device, file.c_str(),
+            buffers[j].data(), buffers[j].size());
+         metadata += "ir stage=" + std::to_string(i) + " file=" + file +
+            " name=" + representations[j].name + " bytes=" +
+            std::to_string(buffers[j].size()) + " saved=" + std::to_string(saved != 0) +
+            " query_result=" + std::to_string(ir_result) + "\n";
+      }
+   }
+   tu_NativeAdrenoShaderCaptureWrite(device, (stem + ".txt").c_str(),
+      metadata.data(), metadata.size());
+}
