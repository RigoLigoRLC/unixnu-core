+      const tu_darwin_pass_profile &pass = profile->passes[i];
+      NativeAdrenoTraceEvent event = trace_cpu_event(state, NativeAdrenoTraceTurnipPassMetadata,
+                                                     "render_pass_identity");
+      trace_argument(&event, NativeAdrenoTraceArgPassId, i + 1);
+      trace_argument(&event, NativeAdrenoTraceArgEncoderId, pass.encoder);
+      trace_argument(&event, NativeAdrenoTraceArgInternalPassIndex, pass.instance);
+      trace_argument(&event, NativeAdrenoTraceArgPassDetails, pass.split_reason);
+      trace_profile_append(state, cmd, submission, event);
+
+      event = trace_cpu_event(state, NativeAdrenoTraceTurnipPassMetadata, "render_pass_execution");
+      trace_argument(&event, NativeAdrenoTraceArgPassId, i + 1);
+      trace_argument(&event, NativeAdrenoTraceArgBins, pass.tiles);
+      trace_argument(&event, NativeAdrenoTraceArgDrawCount, pass.draws);
+      trace_argument(&event, NativeAdrenoTraceArgPassDetails,
+                      pass.rendered | (pass.sysmem << 1) | (pass.binning << 2) |
+                      (pass.lrz << 3) | (pass.mode << 8) | (pass.samples << 16));
+      trace_profile_append(state, cmd, submission, event);
+   }
+
+   for (uint32_t i = 0; i < profile->count; ++i) {
+      tu_darwin_command_count count = profile->counts[profile->occupied[i]];
+      NativeAdrenoTraceEvent event = trace_cpu_event(state, NativeAdrenoTraceTurnipCommandCounts,
+                                                     count.function);
+      if (inherited) {
+         count.pass = inherited_pass;
+      }
+      const tu_darwin_command_profile *executed = inherited ? inherited : profile;
+      if (((count.classification >> 16) & 0xff) == 1 && count.pass &&
+          count.pass <= TRACE_PASS_LIMIT && executed->passes[count.pass - 1].skip_draw_ib) {
+         count.classification |= (uint64_t)8 << 24;
+      }
+      trace_argument(&event, NativeAdrenoTraceArgPassId, count.pass);
+      trace_argument(&event, NativeAdrenoTraceArgCommandClass, count.classification);
+      trace_argument(&event, NativeAdrenoTraceArgEmittedCount, count.emitted);
+      trace_argument(&event, NativeAdrenoTraceArgEstimatedExecutions,
+                      trace_estimated_executions(executed, count));
+      trace_profile_append(state, cmd, submission, event);
+   }
+
+   for (uint32_t i = 0; i < profile->attachment_count; ++i) {
+      const tu_darwin_attachment_profile &attachment = profile->attachments[i];
+      const uint32_t operation = attachment.details & 0xff;
+      if (operation >= 1 && operation <= 4 &&
+          attachment.pass && attachment.pass <= TRACE_PASS_LIMIT &&
+          profile->passes[attachment.pass - 1].sysmem) {
