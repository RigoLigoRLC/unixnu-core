+      }
+      NativeAdrenoTraceEvent event = trace_cpu_event(state, NativeAdrenoTraceTurnipPassAttachment,
+                                                     "gmem_attachment_operation");
+      trace_argument(&event, NativeAdrenoTraceArgPassId,
+                      inherited ? inherited_pass : attachment.pass);
+      trace_argument(&event, NativeAdrenoTraceArgImageId, attachment.image);
+      trace_argument(&event, NativeAdrenoTraceArgAttachmentDetails, attachment.details);
+      trace_argument(&event, NativeAdrenoTraceArgResourceAddress, attachment.address);
+      trace_profile_append(state, cmd, submission, event);
+   }
+
+   NativeAdrenoTraceEvent event = trace_cpu_event(state, NativeAdrenoTraceTurnipMetadataCounts,
+                                                  "command_metadata_capacity");
+   trace_argument(&event, NativeAdrenoTraceArgMetadataDropped, profile->dropped);
+   trace_profile_append(state, cmd, submission, event);
+
