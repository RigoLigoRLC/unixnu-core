+   event.submission_id = submission.submission_id;
+   event.completion_id = submission.completion_id;
+   event.queue_id = submission.queue_id;
+   trace_append_locked(state, cmd->darwin_trace_generation, event);
+}
+
+static uint64_t
+trace_estimated_executions(const tu_darwin_command_profile *profile,
+                           const tu_darwin_command_count &count)
+{
+   uint32_t stream = (count.classification >> 16) & 0xff;
+   uint32_t modes = (count.classification >> 24) & 7;
+   if (stream == 4 || count.pass > TRACE_PASS_LIMIT) {
+      return UINT64_MAX;
+   }
+   if (!count.pass) {
+      return stream == 0 ? count.emitted : UINT64_MAX;
+   }
+
+   const tu_darwin_pass_profile &pass = profile->passes[count.pass - 1];
+   if (!pass.rendered) {
+      return UINT64_MAX;
+   }
+   if (stream == 0) {
+      return count.emitted;
+   }
+   if (stream == 3) {
+      return modes & (pass.sysmem ? 4 : 2) ? count.emitted : 0;
+   }
+
+   uint64_t repetitions = 0;
+   if (pass.sysmem) {
+      repetitions = stream == 1 && (modes & 4) ? 1 : 0;
+   } else {
+      if (modes & 2) {
+         repetitions += pass.tiles;
+      }
+      if (stream == 1 && pass.binning && (modes & 1)) {
+         ++repetitions;
+      }
+   }
+   return count.emitted * repetitions;
+}
+
+static void
+trace_submit_profile(tu_darwin_trace_state *state, tu_cmd_buffer *cmd,
