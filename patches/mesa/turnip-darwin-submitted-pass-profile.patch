+void
+tu_darwin_trace_packet(struct tu_cs *cs, uint32_t opcode, uint32_t event,
+                       const char *function, uint32_t line)
+{
+   uint32_t modes = 7;
+   uint32_t conditional = 0;
+   for (;;) {
+      for (uint32_t i = 0; i < cs->cond_stack_depth; ++i) {
+         uint32_t flags = cs->cond_flags[i];
+         if (pkt_field_get(CP_COND_REG_EXEC_0_MODE, flags) == RENDER_MODE) {
+            uint32_t selected = 0;
+            selected |= (flags & CP_COND_REG_EXEC_0_BINNING) ? 1 : 0;
+            selected |= (flags & CP_COND_REG_EXEC_0_GMEM) ? 2 : 0;
+            selected |= (flags & CP_COND_REG_EXEC_0_SYSMEM) ? 4 : 0;
+            modes &= selected;
+         } else {
+            conditional = 8;
+         }
+      }
+      if (!cs->parent) {
+         break;
+      }
+      cs = cs->parent;
+   }
+
+   tu_cmd_buffer *cmd = cs->darwin_trace_cmd;
+   if (!cmd || !cmd->darwin_profile) {
+      return;
+   }
+
+   tu_darwin_command_profile *profile = cmd->darwin_profile;
+   const uint64_t classification = opcode | ((uint64_t)event << 8) |
+      ((uint64_t)cs->darwin_trace_stream << 16) |
+      ((uint64_t)(modes | conditional) << 24) | ((uint64_t)line << 32);
+   uint32_t slot = (uint32_t)(classification ^ (classification >> 32) ^
+                             (uintptr_t)function ^ (profile->current_pass * 131)) &
+                   (TRACE_COMMAND_SLOTS - 1);
+   for (uint32_t n = 0; n < TRACE_COMMAND_SLOTS; ++n) {
+      tu_darwin_command_count &count = profile->counts[slot];
+      if (!count.function) {
+         count.function = function;
+         count.classification = classification;
+         count.pass = profile->current_pass;
+         profile->occupied[profile->count++] = slot;
+      }
+      if (count.function == function && count.classification == classification &&
+          count.pass == profile->current_pass) {
+         ++count.emitted;
+         return;
+      }
+      slot = (slot + 1) & (TRACE_COMMAND_SLOTS - 1);
+   }
+   ++profile->dropped;
+}
+
+void
+tu_darwin_trace_pass_begin(struct tu_cmd_buffer *cmd)
+{
+   tu_darwin_command_profile *profile = cmd->darwin_profile;
+   if (!profile) {
+      return;
+   }
+   if (profile->pass_count == TRACE_PASS_LIMIT) {
+      ++profile->dropped;
+      profile->current_pass = UINT32_MAX;
+      cmd->darwin_trace_pass_id = UINT32_MAX;
+      return;
+   }
+
+   tu_darwin_pass_profile &pass = profile->passes[profile->pass_count++];
+   profile->current_pass = profile->pass_count;
+   cmd->darwin_trace_pass_id = profile->current_pass;
+   pass.encoder = cmd->darwin_trace_encoder;
+   pass.instance = cmd->darwin_trace_instance;
+   pass.split_reason = cmd->darwin_trace_split_reason;
+}
+
+void
+tu_darwin_trace_pass_render(struct tu_cmd_buffer *cmd, bool sysmem, bool binning)
+{
+   tu_darwin_command_profile *profile = cmd->darwin_profile;
+   if (!profile || !profile->current_pass || profile->current_pass > TRACE_PASS_LIMIT) {
+      return;
+   }
+
+   tu_darwin_pass_profile &pass = profile->passes[profile->current_pass - 1];
+   pass.rendered = true;
+   pass.sysmem = sysmem;
+   pass.binning = binning;
+   pass.draws = cmd->state.rp.drawcall_count;
+   pass.mode = tu_darwin_trace_render_mode(cmd);
+   pass.lrz = cmd->state.lrz.valid;
+   pass.skip_draw_ib = cmd->state.pass->allow_ib2_skipping;
+   for (uint32_t i = 0; i < cmd->state.pass->subpass_count; ++i) {
+      pass.samples = MAX2(pass.samples, cmd->state.pass->subpasses[i].samples);
+   }
+   for (uint32_t i = 0; i < cmd->state.pass->attachment_count; ++i) {
+      if (!cmd->state.attachments[i]) {
+         continue;
+      }
+      const tu_render_pass_attachment &attachment = cmd->state.pass->attachments[i];
+      tu_darwin_trace_attachment(cmd, i, i, 0,
+                                  attachment.load | (attachment.store << 1) |
+                                  (!!attachment.clear_mask << 2) | (attachment.will_be_resolved << 3) |
+                                  (attachment.load_stencil << 4) | (attachment.store_stencil << 5) |
+                                  (attachment.gmem << 6));
+   }
+}
+
+void
+tu_darwin_trace_pass_tile(struct tu_cmd_buffer *cmd)
+{
+   tu_darwin_command_profile *profile = cmd->darwin_profile;
+   if (profile && profile->current_pass && profile->current_pass <= TRACE_PASS_LIMIT) {
+      ++profile->passes[profile->current_pass - 1].tiles;
+   }
+}
+
+void
+tu_darwin_trace_pass_end(struct tu_cmd_buffer *cmd)
+{
+   if (cmd->darwin_profile) {
+      cmd->darwin_profile->current_pass = 0;
+   }
+   cmd->darwin_trace_pass_id = 0;
+}
+
+void
+tu_darwin_trace_attachment(struct tu_cmd_buffer *cmd, uint32_t attachment,
+                           uint32_t gmem_attachment, uint32_t operation, uint32_t flags)
+{
+   tu_darwin_command_profile *profile = cmd->darwin_profile;
+   if (!profile) {
+      return;
+   }
+   if (profile->attachment_count == TRACE_ATTACHMENT_LIMIT) {
+      ++profile->dropped;
+      return;
+   }
+
+   const tu_image_view *view = cmd->state.attachments[attachment];
+   const tu_render_pass_attachment *gmem = &cmd->state.pass->attachments[gmem_attachment];
+   tu_darwin_attachment_profile &record = profile->attachments[profile->attachment_count++];
+   record.pass = profile->current_pass;
+   record.image = (uintptr_t)view->image;
+   record.address = view->image->iova;
+   record.details = operation | ((uint64_t)attachment << 8) |
+      ((uint64_t)gmem_attachment << 16) | ((uint64_t)flags << 24) |
+      ((uint64_t)(uint32_t)gmem->format << 32);
+}
+
+uint32_t
+tu_darwin_trace_render_mode(struct tu_cmd_buffer *cmd)
+{
+   tu_darwin_trace_state *state = trace_state(cmd->device);
+   if (!state || !cmd->darwin_trace_generation ||
+       cmd->darwin_trace_generation != p_atomic_read(&state->active_generation)) {
+      return 0;
+   }
+   return p_atomic_read(&state->capture_flags) &
+      (NativeAdrenoTraceCaptureForceGmem | NativeAdrenoTraceCaptureForceSysmem);
+}
