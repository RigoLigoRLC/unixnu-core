+static void
+darwin_clean_completed_cache_locked(struct darwin_retire_state *retire)
+{
+   const uint32_t pressure = p_atomic_read(&darwin_memory_pressure);
+   if (retire->pressure_seen != pressure) {
+      retire->pressure_seen = pressure;
+      ++retire->cache_flushes;
+      while (!list_is_empty(&retire->cache)) {
+         struct darwin_bo_node *node = list_first_entry(&retire->cache, struct darwin_bo_node, link);
+         darwin_evict_cached_locked(retire, node, DARWIN_EVICT_BYTES);
+      }
+      return;
+   }
+
+   const uint64_t now = os_time_get_nano();
+   if (retire->cache_cleaned_s == now / 1000000000) {
+      return;
+   }
+   retire->cache_cleaned_s = now / 1000000000;
+   while (!list_is_empty(&retire->cache)) {
+      struct darwin_bo_node *node = list_first_entry(&retire->cache, struct darwin_bo_node, link);
+      if (now - node->cached_ns < 2000000000ull) {
+         break;
+      }
+      darwin_evict_cached_locked(retire, node, DARWIN_EVICT_BYTES);
+   }
+}
