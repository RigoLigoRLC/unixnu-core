+struct tu_bo;
+struct tu_queue;
+struct tu_darwin_pm4_snapshot;
+
+struct tu_darwin_pm4_snapshot *tu_darwin_pm4_begin(struct tu_queue *queue);
+void tu_darwin_pm4_resource(struct tu_darwin_pm4_snapshot *capture, struct tu_bo *bo);
+void tu_darwin_pm4_ib(struct tu_darwin_pm4_snapshot *capture, uint64_t address, uint32_t bytes);
+void tu_darwin_pm4_command(struct tu_darwin_pm4_snapshot *capture, uint64_t recording_id);
+void tu_darwin_pm4_prepare(struct tu_darwin_pm4_snapshot *capture);
